<div class="training-workspace pieceless-workspace" data-solution-format="<%= @solution_format %>">
<%= render ListudyWeb.ComponentView, "training_header.html", conn: @conn, locale: @locale, title: gettext("Pieceless Tactics") %>
<div class="with_sidebar">
  <div id="game_container" class="sidebar_main">
    <div class="study-board-frame"><%= render ListudyWeb.ComponentView, "chessground.html" %><%= render ListudyWeb.ComponentView, "promotion_picker.html" %></div>
  </div>
  <div class="sidebar">
    <p class="training-instruction"><%= dgettext("tactics", "Picture the listed pieces on the empty board, then play the winning moves.") %></p>

    <%= render ListudyWeb.ComponentView, "infoboxes.html" %>
    
    <div id="pieceless_context">
      <% color = "<span id=\"pieceless_to_play\"></span>" %>
      <p><%= raw dgettext("tactics", "%{color} to play.", color: color) %></p>
      <div id="pieceless_pieces"></div>
      <p id="history_container" class="hidden"><%= dgettext("tactics", "History") %>: <span id="history"></span></p>

      <div class="training-actions">
        <a id="next" class="hidden button continue_button" href="<%= @next_url %>"><%= dgettext("tactics", "Next puzzle") %></a>
        <button type="button" id="give-up"><%= dgettext("tactics", "Show solution") %></button>
        <button type="button" id="training_restart"><%= dgettext("tactics", "Retry") %></button>
      </div>
    </div>
    <details class="training-help"><summary><%= dgettext("tactics", "How to play") %></summary>
      <p><%= dgettext("tactics", "The list shows the starting position. Track each move in your mind. Use Show solution to see the pieces and the continuation.") %></p>
    </details>
  </div>
</div>
</div>

<link rel="stylesheet" href="<%= Routes.static_path(@conn, "/css/chessground.css") %>"/>
<link rel="stylesheet" href="<%= Routes.static_path(@conn, "/css/features/pieceless.css") %>"/>
<script defer type="text/javascript" src="<%= Routes.static_path(@conn, "/js/pieceless_tactics.js") %>"></script>
<script <%= raw ListudyWeb.Plugs.CSP.put_nonce(@conn) %>>
let fen = "<%= @pieceless_tactic.fen %>";
let solution = "<%= @pieceless_tactic.solution %>";

let i18n = {};
i18n.success = "<%= dgettext "tactics", "Tactic solved!"%>";
i18n.wrong_move = "<%= dgettext "tactics", "Wrong Move"%>";
i18n.right_move = "<%= dgettext "tactics", "Correct move, there are still more moves." %> ";
i18n.solved = "<%= dgettext "tactics", "Solved!" %> ";
i18n.white = "<%= dgettext "tactics", "White" %> ";
i18n.black = "<%= dgettext "tactics", "Black" %> ";
</script>
