<% modal_id = "#{@book.slug}_#{@shop.name}_modal" %>
<button type="button" data-bs-toggle="modal" data-bs-target="#<%= modal_id %>"><span><%= @shop.name %></span></button>
<%= render ListudyWeb.ComponentView, "ui_modal.html", id: modal_id, title: dgettext("book", "%{shop_name} Affiliate Disclosure", shop_name: @shop.name), centered: false, animated: false, modal_class: "book-modal", body: render("_affiliate_body.html", assigns) %>
