<dialog id="study_settings_dialog" class="study-dialog" aria-labelledby="study_settings_title">
  <header class="study-dialog-header">
    <h2 id="study_settings_title"><%= dgettext("study", "Settings") %></h2>
    <form method="dialog"><button type="submit"><%= dgettext("study", "Close") %></button></form>
  </header>
  <div class="study-settings-tabs" role="tablist" aria-label="<%= dgettext("study", "Settings sections") %>">
    <button type="button" id="settings_tab_general" role="tab" aria-controls="settings_panel_general" aria-selected="true" tabindex="0" data-settings-tab="general"><%= dgettext("study", "General") %></button>
    <button type="button" id="settings_tab_practice" role="tab" aria-controls="settings_panel_practice" aria-selected="false" tabindex="-1" data-settings-tab="practice"><%= dgettext("study", "Practice") %></button>
    <button type="button" id="settings_tab_sparring" <%= if @study.training_kind == "tactics", do: "hidden" %> role="tab" aria-controls="settings_panel_sparring" aria-selected="false" tabindex="-1" data-settings-tab="sparring"><%= dgettext("study", "Sparring") %></button>
  </div>
  <div id="settings_panel_general" class="study-settings-grid" role="tabpanel" aria-labelledby="settings_tab_general" data-settings-panel="general">
<fieldset class="study-setting-group"><legend><%= dgettext("study", "Hints and explanations") %></legend>
<div class="option_item study-setting-row">
    <span class="study-setting-label" id="setting_arrows_label"><%= dgettext("study", "Move arrows") %></span>
    <button type="button" data-icon="-" id="arrows_toggle" aria-describedby="setting_arrows_label">placeholder</button>
  </div>
<div class="option_item study-setting-row">
    <span class="study-setting-label" id="setting_comments_label"><%= dgettext("study", "Move comments") %></span>
    <button type="button" data-icon="3" id="comments_toggle" aria-describedby="setting_comments_label" title="<%= dgettext("study", "Option to control when comments are displayed") %>">placeholder</button>
  </div>
<div class="option_item study-setting-row">
    <span class="study-setting-label" id="setting_hint_label"><%= dgettext("study", "Hint content") %></span>
    <button type="button" data-icon="-" id="arrow_type" aria-describedby="setting_hint_label" title="<%= dgettext("study", "Option to control the type of hints shown. 'Moves' means arrows are displayed for all playable moves in the study. 'Annotations' are arrows and circles from the study or PGN file. These can be created at Lichess.org and other sites.") %>">placeholder</button>
  </div>
</fieldset>
<fieldset class="study-setting-group"><legend><%= dgettext("study", "Practice pace") %></legend>
<div class="option_item" hidden>
    <a class="icon" data-icon="$" id="key_move" title="<%= dgettext("study", "Don't repeat the early moves that are already known. Skips to the first branching move in the study.") %>">placeholder</a>
  </div>
<div class="option_item study-setting-row">
    <span class="study-setting-label" id="setting_delay_label"><%= dgettext("study", "Opponent move delay") %></span>
    <button type="button" data-icon="(" id="move_delay" aria-describedby="setting_delay_label"><%= dgettext("study", "Move delay:") %> <span id="move_delay_time">placeholder</span></button>
  </div>
<div class="option_item study-setting-row">
    <span class="study-setting-label" id="setting_review_label"><%= dgettext("study", "End-of-line review") %></span>
    <button type="button" data-icon="(" id="line_review" aria-describedby="setting_review_label" title="<%= dgettext("study", "At the end of lines the board is only reset after 3 seconds giving you time to review the final position.") %>">placeholder</button>
  </div>

</fieldset>

  </div>
  <div id="settings_panel_practice" class="study-settings-grid" role="tabpanel" aria-labelledby="settings_tab_practice" data-settings-panel="practice" hidden>
<fieldset class="study-setting-group"><legend><%= dgettext("study", "Practice depth") %></legend>
<div class="option_item study-depth-setting">
    <label class="study-depth-toggle"><input type="checkbox" id="limit_practice_depth" aria-describedby="max_depth_help"> <%= dgettext("study", "Limit practice depth") %></label>
    <div id="max_depth_container">
      <label for="max_depth_range"><%= dgettext("study", "Max depth: ") %><output id="max_depth_label" class="max_depth_label" for="max_depth_range">1</output></label>
      <div class="study-depth-controls">
        <button type="button" id="max_depth_sub" disabled aria-label="<%= dgettext("study", "Decrease max depth") %>">−</button>
        <input type="range" id="max_depth_range" class="max_depth_range" min="1" max="1" value="1" disabled aria-describedby="max_depth_help">
        <button type="button" id="max_depth_add" disabled aria-label="<%= dgettext("study", "Increase max depth") %>">+</button>
      </div>
    </div>
    <p id="max_depth_help"><%= dgettext("study", "Limits Full lines and Smart to this depth in this chapter. Deeper positions and their review schedules are preserved. Changes apply when you close Settings.") %></p>
  </div>
</fieldset>
<fieldset class="study-setting-group study-session-settings"><legend><%= dgettext("study", "Study sessions") %></legend>
  <label for="study_session_goal"><%= dgettext("study", "Smart session goal") %></label>
  <div class="study-session-goal-input">
    <input type="number" id="study_session_goal" min="5" max="200" step="1" value="20" inputmode="numeric" aria-describedby="study_session_goal_help">
    <span><%= dgettext("study", "decisions") %></span>
  </div>
  <p id="study_session_goal_help"><%= dgettext("study", "Applies to your next Smart session. Finish the current chain when the goal is reached. Corrections and automatic moves do not add decisions.") %></p>
</fieldset>
  </div>
  <div id="settings_panel_sparring" class="study-settings-grid" role="tabpanel" aria-labelledby="settings_tab_sparring" data-settings-panel="sparring" hidden>
<%= render "_sparring_settings.html" %>
  </div>
</dialog>
