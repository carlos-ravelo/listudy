  <div class="study-settings-tabs" role="tablist" aria-label="<%= dgettext("study", "Settings sections") %>">
    <button type="button" class="active" id="settings_tab_general" role="tab" aria-controls="settings_panel_general" aria-selected="true" tabindex="0" data-bs-toggle="tab" data-settings-tab="general" data-bs-target="#settings_panel_general"><%= dgettext("study", "General") %></button>
    <button type="button" id="settings_tab_practice" role="tab" aria-controls="settings_panel_practice" aria-selected="false" tabindex="-1" data-bs-toggle="tab" data-settings-tab="practice" data-bs-target="#settings_panel_practice"><%= dgettext("study", "Practice") %></button>
    <button type="button" id="settings_tab_sparring" <%= if @study.training_kind == "tactics", do: "hidden" %> role="tab" aria-controls="settings_panel_sparring" aria-selected="false" tabindex="-1" data-bs-toggle="tab" data-settings-tab="sparring" data-bs-target="#settings_panel_sparring"><%= dgettext("study", "Sparring") %></button>
  </div>
  <div id="settings_panel_general" x-data="studyPreferences" @study-preferences-updated.window="update($event.detail)" class="study-settings-grid tab-pane active" role="tabpanel" aria-labelledby="settings_tab_general" data-settings-panel="general">
<fieldset class="study-setting-group"><legend><%= dgettext("study", "Hints and explanations") %></legend>
<div class="option_item study-setting-row">
    <span class="study-setting-label" id="setting_arrows_label"><%= dgettext("study", "Move arrows") %></span>
    <button type="button" data-icon="-" id="arrows_toggle" @click="cycle('arrows')" x-text="values.arrows" :disabled="!ready" aria-describedby="setting_arrows_label">placeholder</button>
  </div>
<div class="option_item study-setting-row">
    <span class="study-setting-label" id="setting_comments_label"><%= dgettext("study", "Move comments") %></span>
    <button type="button" data-icon="3" id="comments_toggle" @click="cycle('comments')" x-text="values.comments" :disabled="!ready" aria-describedby="setting_comments_label" title="<%= dgettext("study", "Option to control when comments are displayed") %>">placeholder</button>
  </div>
<div class="option_item study-setting-row">
    <span class="study-setting-label" id="setting_hint_label"><%= dgettext("study", "Hint content") %></span>
    <button type="button" data-icon="-" id="arrow_type" @click="cycle('arrowType')" x-text="values.arrowType" :disabled="!ready" aria-describedby="setting_hint_label" title="<%= dgettext("study", "Option to control the type of hints shown. 'Moves' means arrows are displayed for all playable moves in the study. 'Annotations' are arrows and circles from the study or PGN file. These can be created at Lichess.org and other sites.") %>">placeholder</button>
  </div>
</fieldset>
<fieldset class="study-setting-group"><legend><%= dgettext("study", "Practice pace") %></legend>
<div class="option_item" hidden>
    <a class="icon" data-icon="$" id="key_move" :data-icon="keyMovesEnabled ? '$' : '%'" @click="cycle('keyMoves')" x-text="values.keyMoves" :disabled="!ready" title="<%= dgettext("study", "Don't repeat the early moves that are already known. Skips to the first branching move in the study.") %>">placeholder</a>
  </div>
<div class="option_item study-setting-row">
    <span class="study-setting-label" id="setting_delay_label"><%= dgettext("study", "Opponent move delay") %></span>
    <button type="button" data-icon="(" id="move_delay" @click="cycle('moveDelay')" :disabled="!ready" aria-describedby="setting_delay_label"><%= dgettext("study", "Move delay:") %> <span id="move_delay_time" x-text="values.moveDelay">placeholder</span></button>
  </div>
<div class="option_item study-setting-row">
    <span class="study-setting-label" id="setting_review_label"><%= dgettext("study", "End-of-line review") %></span>
    <button type="button" data-icon="(" id="line_review" @click="cycle('review')" x-text="values.review" :disabled="!ready" aria-describedby="setting_review_label" title="<%= dgettext("study", "At the end of lines the board is only reset after 3 seconds giving you time to review the final position.") %>">placeholder</button>
  </div>

</fieldset>

  </div>
  <div id="settings_panel_practice" class="study-settings-grid tab-pane" role="tabpanel" aria-labelledby="settings_tab_practice" data-settings-panel="practice" hidden>
<fieldset class="study-setting-group"><legend><%= dgettext("study", "Practice depth") %></legend>
<div id="study_depth_settings" class="option_item study-depth-setting" x-data="studyDepth" @study-depth-updated.window="update($event.detail)">
    <label class="study-depth-toggle"><input type="checkbox" id="limit_practice_depth" :checked="enabled" :disabled="!ready" @change="change('enable', $event.target.checked)" aria-describedby="max_depth_help"> <%= dgettext("study", "Limit practice depth") %></label>
    <div id="max_depth_container" :class="{'option-highlighted': enabled && depth < available}">
      <label for="max_depth_range"><%= dgettext("study", "Max depth: ") %><output id="max_depth_label" class="max_depth_label" x-text="depth" for="max_depth_range">1</output></label>
      <div class="study-depth-controls">
        <button type="button" id="max_depth_sub" @click="change('step', -1)" :disabled="!ready || !enabled || depth <= 1" disabled aria-label="<%= dgettext("study", "Decrease max depth") %>">−</button>
        <input type="range" id="max_depth_range" class="max_depth_range" :max="available" :value="depth" :disabled="!ready || !enabled || available <= 1" @input="change('depth', $event.target.value)" @change="change('depth', $event.target.value)" min="1" max="1" value="1" disabled aria-describedby="max_depth_help">
        <button type="button" id="max_depth_add" @click="change('step', 1)" :disabled="!ready || !enabled || depth >= available" disabled aria-label="<%= dgettext("study", "Increase max depth") %>">+</button>
      </div>
    </div>
    <p id="max_depth_help"><%= dgettext("study", "Limits Full lines and Smart to this depth in this chapter. Deeper positions and their review schedules are preserved. Changes apply when you close Settings.") %></p>
    <fieldset class="study-depth-bulk">
      <legend class="study-depth-bulk-heading">
        <%= dgettext("study", "All chapters") %>
        <span class="study-depth-help" x-data="{ open: false, pinned: false }" @mouseenter="open = true" @mouseleave="if (!pinned) open = false" @click.outside="open = pinned = false" @keydown.escape.stop="open = pinned = false; $refs.help.focus()" @focusout="if (!$el.contains($event.relatedTarget)) open = pinned = false">
          <button type="button" class="study-depth-info" x-ref="help" @click="pinned = !pinned; open = pinned" @focus="open = true" :aria-expanded="open" aria-controls="study_depth_bulk_help" aria-label="<%= dgettext("study", "About bulk depth settings") %>"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7v2"/></svg></button>
          <span id="study_depth_bulk_help" class="dropdown-menu show study-depth-popover" role="region" aria-label="<%= dgettext("study", "About bulk depth settings") %>" x-show="open" x-cloak>
            <span><strong><%= dgettext("study", "Adjust depth:") %></strong> <%= dgettext("study", "Increase or decrease the depth of all limited chapters by one. Unlimited chapters remain unchanged.") %></span>
            <span><strong><%= dgettext("study", "Apply to all:") %></strong> <%= dgettext("study", "Apply the currently selected depth and limit settings to every chapter, replacing their individual configurations.") %></span>
          </span>
        </span>
      </legend>
      <div class="study-depth-bulk-row">
        <span><%= dgettext("study", "Adjust depth across chapters") %></span>
        <div class="study-depth-bulk-actions" role="group" aria-label="<%= dgettext("study", "Adjust depth across chapters") %>">
          <button type="button" class="btn btn-outline-secondary" @click="change('stepAll', -1)" :disabled="!ready" aria-label="<%= dgettext("study", "Decrease depth by 1 in all limited chapters") %>">−1</button>
          <button type="button" class="btn btn-outline-secondary" @click="change('stepAll', 1)" :disabled="!ready" aria-label="<%= dgettext("study", "Increase depth by 1 in all limited chapters") %>">+1</button>
        </div>
      </div>
      <div class="study-depth-bulk-row">
        <span><%= dgettext("study", "Use current settings") %></span>
        <button type="button" class="btn btn-outline-secondary" @click="change('applyAll')" :disabled="!ready"><%= dgettext("study", "Apply to all") %></button>
      </div>
    </fieldset>
  </div>
</fieldset>
<fieldset class="study-setting-group study-session-settings"><legend><%= dgettext("study", "Study sessions") %></legend>
  <label for="study_session_goal"><%= dgettext("study", "Smart session goal") %></label>
  <div class="study-session-goal-input">
    <input type="number" id="study_session_goal" min="5" max="200" step="1" value="20" inputmode="numeric" aria-describedby="study_session_goal_help">
    <span><%= dgettext("study", "decisions") %></span>
  </div>
  <p id="study_session_goal_help"><%= dgettext("study", "Applies to your next Smart session. Finish the current chain when the goal is reached. Corrections and automatic moves do not add decisions.") %></p>
</fieldset>
  </div>
  <div id="settings_panel_sparring" class="study-settings-grid tab-pane" role="tabpanel" aria-labelledby="settings_tab_sparring" data-settings-panel="sparring" hidden>
<%= render "_sparring_settings.html" %>
  </div>
