<div x-data="{ chapters: [], weakRunActive: false, spacedReviewActive: false, practiceMode: 'chapters' }"
     x-on:study-progress-updated.window="chapters = &#36;event.detail"
     x-on:study-weak-run-updated.window="weakRunActive = &#36;event.detail.active"
     x-on:study-spaced-run-updated.window="spacedReviewActive = &#36;event.detail.active">
    <section class="study-time-summary" aria-labelledby="study_time_title">
      <h4 id="study_time_title"><%= dgettext("study", "Practice time") %></h4>
      <p id="study_time_today"></p>
      <p id="study_time_total"></p>
      <details class="study-session-history">
        <summary><%= dgettext("study", "Recent sessions") %></summary>
        <ol id="study_session_history"></ol>
      </details>
      <p class="study-time-help"><%= dgettext("study", "Tracks practice from now on. Time pauses in hidden tabs and after two minutes without activity. Reading time is excluded.") %></p>
    </section>
    <div class="study_progress" id="study_progress">
      <template x-for="chapter in chapters" :key="chapter.index">
        <button type="button" class="chapter-progress-summary"
          :class="'chapter-progress-summary--' + (chapter.reviewDue ? 'due' : chapter.pickerTone === 'mistakes' ? 'watch' : 'unrated') + (chapter.current ? ' chapter-progress-summary--current' : '')"
          :aria-current="chapter.current ? 'true' : null"
          x-on:click="$dispatch('study-progress-open-chapter', { index: chapter.index })">
          <strong x-text="chapter.name"></strong>
          <span class="chapter-progress-cues" x-show="chapter.current || chapter.scopeComplete || chapter.reviewDue">
            <span class="chapter-progress-current" x-show="chapter.current"><%= dgettext("study", "Current chapter") %></span>
            <span class="chapter-progress-solid" x-show="chapter.scopeComplete" x-text="chapter.limited ? $el.dataset.scopedLabel : $el.dataset.fullLabel"
                  data-scoped-label="<%= dgettext("study", "All continuations within limit practiced") %>"
                  data-full-label="<%= dgettext("study", "All continuations practiced") %>"></span>
            <span class="chapter-progress-due" x-show="chapter.reviewDue"><%= dgettext("study", "Review due") %></span>
          </span>
          <span x-text="chapter.coverageLabel" title="<%= dgettext("study", "Continuations answered correctly without help at least once. This does not measure lasting recall.") %>"></span>
          <span x-show="chapter.limited" x-text="chapter.fullCoverageLabel"></span>
          <span x-text="chapter.recallLabel" title="<%= dgettext("study", "First-try accuracy in the last 20 graded continuation reviews, excluding each initial encounter. Hints count as misses.") %>"></span>
          <span x-text="chapter.pendingLabel"></span>
          <span x-text="chapter.metrics"></span>
          <span x-show="chapter.reviewLabel && !chapter.reviewDue" x-text="chapter.reviewLabel"></span>
        </button>
      </template>
    </div>
    <div class="study-progress-actions">
      <button type="button" class="secondary" id="review_due_chapters"
        x-show="spacedReviewActive || chapters.some(chapter => chapter.reviewDue)"
        x-on:click="$dispatch('study-progress-toggle-spaced-run')"
        data-start-label="<%= dgettext("study", "Review due chapters") %>"
        data-stop-label="<%= dgettext("study", "Stop reviews") %>"
        x-text="spacedReviewActive ? $el.dataset.stopLabel : $el.dataset.startLabel + ' (' + chapters.filter(chapter => chapter.reviewDue).length + ')'"></button>
      <button type="button" class="secondary" id="practice_weak_chapters"
        x-show="weakRunActive || chapters.some(chapter => practiceMode === 'positions' ? chapter.failedPositions > 0 : chapter.errors > 0 && !chapter.mastered)"
        x-on:click="$dispatch('study-progress-toggle-weak-run')"
        data-start-label="<%= dgettext("study", "Practice weak chapters") %>"
        data-stop-label="<%= dgettext("study", "Stop weak practice") %>"
        x-text="weakRunActive ? $el.dataset.stopLabel : $el.dataset.startLabel"></button>
      <label class="study-practice-mode" for="weak_practice_mode">
        <span><%= dgettext("study", "Practice") %></span>
        <select id="weak_practice_mode" x-model="practiceMode" :disabled="weakRunActive">
          <option value="chapters"><%= dgettext("study", "Full chapters") %></option>
          <option value="positions"><%= dgettext("study", "Failed positions") %></option>
        </select>
      </label>
      <button id="study_progress_reset" class="tertiary"><%= dgettext("study", "Reset progress") %></button>
    </div>
</div>
