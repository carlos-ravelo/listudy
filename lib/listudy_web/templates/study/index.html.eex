<div class="study-library" data-study-library>
  <div class="study-library-heading">
    <h1><%= dgettext("study", "Your Studies") %></h1>
    <%= link dgettext("study", "New Study"), to: Routes.study_path(@conn, :new, @locale), class: "button study-library-create" %>
  </div>
  <%= if @studies != [] or @favorites != [] do %>
    <div class="study-library-toolbar" data-library-controls hidden>
      <input type="search" data-library-search aria-label="<%= dgettext("study", "Search your studies") %>" placeholder="<%= dgettext("study", "Search your studies") %>">
      <div class="study-library-filters" role="group" aria-label="<%= dgettext("study", "Study color") %>">
        <%= for {value, label} <- [{"all", dgettext("study", "All")}, {"white", dgettext("study", "White")}, {"black", dgettext("study", "Black")}] do %>
          <button type="button" data-library-color="<%= value %>" aria-pressed="<%= value == "all" %>"><%= label %></button>
        <% end %>
      </div>
      <span class="study-library-count" data-library-count role="status" aria-live="polite"></span>
    </div>
  <% end %>
  <%= if @studies == [] do %>
    <div class="study-library-empty">
      <p><%= dgettext("study", "Create a new study and start learning.") %></p>
      <%= link dgettext("study", "Search for Studies"), to: Routes.search_path(@conn, ListudyWeb.StudySearchLive, @locale) %>
    </div>
  <% else %>
    <section data-library-section aria-label="<%= dgettext("study", "Your Studies") %>">
      <%= render "_library_list.html", studies: @studies, conn: @conn, locale: @locale, editable: true %>
    </section>
  <% end %>
  <%= if @favorites != [] do %>
    <section class="study-library-favorites" data-library-section aria-labelledby="library-favorites-title">
      <h2 id="library-favorites-title"><%= dgettext("study", "Favored Studies") %></h2>
      <%= render "_library_list.html", studies: @favorites, conn: @conn, locale: @locale, editable: false %>
    </section>
  <% end %>
  <p class="study-library-empty" data-library-empty hidden><%= dgettext("study", "No studies match these filters.") %></p>
</div>
