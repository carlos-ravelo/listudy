      <input class="form-control" data-modal-autofocus type="search" x-ref="search" x-model="query" @keydown.enter.prevent
             aria-label="<%= dgettext("study", "Search openings") %>" autocomplete="off"
             placeholder="<%= dgettext("study", "Search openings…") %>">
      <ul class="study-opening-options">
        <%= for opening <- @openings do %>
          <li x-show="matches($el.dataset.name)" data-name="<%= opening.name %>">
            <button type="button" data-id="<%= opening.id %>" data-name="<%= opening.name %>"
                    :aria-pressed="selected === $el.dataset.id" @click="choose($el.dataset.id, $el.dataset.name)"><%= opening.name %></button>
          </li>
        <% end %>
      </ul>
      <p class="study-opening-empty" x-show="!names.some(value => matches(value))" role="status"><%= dgettext("study", "No openings match your search.") %></p>
