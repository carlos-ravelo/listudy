<%= form_for @assigns.changeset, @action, [multipart: true, class: if(Map.get(@assigns, :maintenance, false), do: "study-management-form", else: "study-form"), "x-data": if(Map.get(@assigns, :maintenance, false), do: "studyMetadata", else: "{ changed: false }"), "@submit": if(Map.get(@assigns, :maintenance, false), do: "save($event)", else: ""), "@input": "changed = true", "@change": "changed = true"], fn f -> %>
  <%= if @assigns.changeset.action do %>
    <div class="alert alert-danger">
      <p>Oops, something went wrong! Please check the errors below.</p>
    </div>
  <% end %>

  <div class="study-metadata-title">
  <%= label f, :title, dgettext("study", "Title") %>
  <%= text_input f, :title, class: "big_input", minlength: 3, maxlength: 60, placeholder: dgettext("study", "Caro-Kann Defense"), required: true, autofocus: not Map.get(@assigns, :maintenance, false) %>
  <%= error_tag f, :title %>
  </div>

  <div class="study-metadata-line">
  <div class="study-metadata-description">

  <%= label f, :description, dgettext("study", "Description") %>
  <%= textarea f, :description, class: "big_input", minlength: 20, maxlength: 1000, required: true, placeholder: dgettext("study", "In this study I work on my 1.e4 openings...") %>
  <%= error_tag f, :description %>

  </div>
  </div>

  <div class="study-management-settings-row">
  <div class="study-metadata-opening">
  <%= label f, :opening_id, dgettext("study", "Opening") %>
  <%= select(f, :opening_id, Enum.map(@assigns.openings, fn %{name: name, id: id} -> [key: name, value: id] end), selected: selected_opening(@assigns), class: "study_opening_id big_input") %>

  </div>
    <div class="study-management-side">
      <%= label f, :color, dgettext("study", "For which side is this study") %>
      <%= select(f, :color, ["White": "white", "Black": "black"]) %>
    </div>
    <div class="study-management-private">
      <%= label f, :private, dgettext("study", "Keep this study private") %>
      <%= checkbox f, :private %>
    </div>
  </div>

  <div class="study-management-import-card pgn_choice">
    <h3 style="margin-top:0; font-size: 14px;"><%= dgettext("study", "Import PGN or Lichess Study") %></h3>
    <div class="study-management-import-grid">
      <div>
        <%= label f, :pgn, dgettext("study", "Select a PGN to upload") %>
        <%= file_input f, :pgn %>
      </div>
      <div>
        <%= label f, :lichess_study, dgettext("study", "Lichess Study") %>
        <%= text_input f, :lichess_study, placeholder: "https://lichess.org/study/ZWHbJIPd", class: "big_input" %>
        <%= error_tag f, :lichess_study %>
      </div>
    </div>
  </div>
  <%= if Map.get(@assigns, :maintenance, false) do %>
    <p class="study-management-status" role="status" x-text="status"></p>
  <% end %>

  <script type="text/javascript" src="<%= Routes.static_path(@assigns.conn, "/js/jquery-3.5.1.min.js") %>"></script>
  <script type="text/javascript" src="<%= Routes.static_path(@assigns.conn, "/js/select2.min.js") %>"></script>
  <link rel="stylesheet" href="<%= Routes.static_path(@assigns.conn, "/css/select2.min.css") %>"/>

  
<style>
.select2-container {
  color: black;
}
.study-form button {
  margin-top: 20px;
}
</style>

<script <%= raw ListudyWeb.Plugs.CSP.put_nonce(@assigns.conn) %>>
$(document).ready(function() {
    <%= unless Map.get(@assigns, :maintenance, false) do %>
    $('#study_opening_id').select2();
    <% end %>
});
</script>

<div <%= if Map.get(@assigns, :maintenance, false) and is_nil(@assigns.changeset.action), do: raw("x-show=\"changed\" x-cloak") %>>
  <%= submit "Save", class: "primary", "x-bind:disabled": "typeof saving !== 'undefined' && saving" %>
  <%= unless Map.get(@assigns, :maintenance, false) do %>
    <button class="go-back tertiary"><%= dgettext("study", "Back") %></button>
  <% end %>
</div>
<% end %>
