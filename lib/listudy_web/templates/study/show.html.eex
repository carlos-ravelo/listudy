<div data-training-kind="<%= @study.training_kind %>" class="study-workspace practice-page" data-game-positions-url="<%= if @study.is_owner, do: Routes.analysis_path(@conn, :positions, @study.id), else: "" %>">
<div class="study-session-controls">
  <div id="study_practice_choices" role="group" aria-label="<%= dgettext("study", "Study mode") %>">
    <button type="button" id="study_mode" aria-pressed="false"><%= dgettext("study", "Read") %></button>
    <button type="button" id="practice_smart" <%= if @study.training_kind == "tactics", do: "hidden" %> aria-pressed="false">Smart</button>
    <button type="button" id="practice_lines" aria-pressed="true"><%= dgettext("study", "Full lines") %></button>
    <button type="button" id="practice_sparring" <%= if @study.training_kind == "tactics", do: "hidden disabled" %> aria-pressed="false" aria-controls="study_sparring"><%= dgettext("study", "Sparring") %></button>
  </div>
  <label id="line_order_control" for="puzzle_run"><%= dgettext("study", "After a line") %>
    <select id="puzzle_run">
      <option value="off"><%= dgettext("study", "Stay in this chapter") %></option>
      <option value="next"><%= dgettext("study", "Next chapter") %></option>
      <option value="random"><%= dgettext("study", "Random chapter") %></option>
    </select>
  </label>
  <button type="button" id="stop_smart_run" hidden><%= dgettext("study", "Stop session") %></button>
  <div class="study-session-tools">
  <%= render "_study_tools.html", study: @study, conn: @conn, locale: @locale %>
  <button type="button" id="progress" data-bs-toggle="modal" data-bs-target="#progress_modal"><%= dgettext("study", "Progress") %></button>

  <button type="button" id="open_study_settings" data-study-dialog="study_settings_dialog"
          aria-label="<%= dgettext("study", "Settings") %>" title="<%= dgettext("study", "Settings") %>">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />
      <path d="M9 2h6l.5 2 1.7 1 2-.6 3 5.2-1.5 1.4v2l1.5 1.4-3 5.2-2-.6-1.7 1-.5 2H9l-.5-2-1.7-1-2 .6-3-5.2L3.3 13v-2L1.8 9.6l3-5.2 2 .6 1.7-1Z" />
    </svg>
  </button>
  </div>
</div>

<div class="study-context">
  <h1 class="study-feature-title" title="<%= String.replace(@study.title, "_", " ") %>"><%= String.replace(@study.title, "_", " ") %></h1>
  <%= render "_chapter_controls.html" %>
</div>

<div id="study_layout" class="with_sidebar" x-data="{ reading: false, expanded: false, overflowing: false }"
     :class="{ 'study-reading-layout': reading }"
     @study-reading-updated.window="if (reading !== $event.detail.reading) { reading = $event.detail.reading; $nextTick(() => $dispatch('study-reading-layout-updated')); } expanded = false; $nextTick(() => overflowing = $refs.comments.scrollHeight > $refs.comments.clientHeight)">
  <div id="game_container" class="sidebar_main">
    <%= if @study.training_kind == "tactics" do %>
      <section id="study_visualization" class="study-visualization"
               aria-label="<%= dgettext("study", "Visualization training") %>"
               data-hide="<%= dgettext("study", "Hide pieces") %>"
               data-reveal="<%= dgettext("study", "Show pieces (help)") %>"
               data-memorize="<%= dgettext("study", "Memorize the position, then play %count% of your moves with the pieces hidden.") %>"
               data-hidden="<%= dgettext("study", "Pieces hidden · Your moves: %count%") %>"
               data-complete="<%= dgettext("study", "Line complete. Reset or choose another exercise.") %>"
               data-reply="<%= dgettext("study", "Opponent played") %>"
               data-history="<%= dgettext("study", "Without help: %clean%/%total% runs") %>">
        <label><input type="checkbox"> <%= dgettext("study", "Visualization") %></label>
        <select aria-label="<%= dgettext("study", "Moves with hidden pieces") %>" hidden>
          <option value="auto"><%= dgettext("study", "Adaptive difficulty") %></option>
          <option value="1"><%= dgettext("study", "1 move") %></option>
          <option value="2"><%= dgettext("study", "2 moves") %></option>
          <option value="4"><%= dgettext("study", "4 moves") %></option>
        </select>
        <button type="button" class="secondary" aria-pressed="false" hidden><%= dgettext("study", "Hide pieces") %></button>
        <p role="status" aria-live="polite" hidden></p>
        <small data-visualization-history hidden></small>
      </section>
    <% end %>
    <%= render "_sparring_status.html" %>
    <div class="study-board-frame">
      <%= render ListudyWeb.ComponentView, "chessground.html" %>
      <%= render ListudyWeb.ComponentView, "promotion_picker.html" %>
    </div>
    <div id="study_board_actions" class="study-board-actions">
<!-- Actions used while training -->
<div class="study-primary-actions" x-data="{ reading: false }" @study-reading-updated.window="reading = $event.detail.reading">
  <button type="button" id="hints" class="secondary" x-show="!reading"><%= dgettext("study", "Hint") %></button>
    <button type="button" class="secondary" id="replay_position_context" hidden><%= dgettext("study", "Replay from the start") %></button>

<div class="option_item">
    <button type="button" class="secondary" id="reset_line" data-reset-game="<%= dgettext("study", "Reset game") %>"><%= dgettext("study", "Reset line") %></button>
  </div>

<div class="option_item">
    <a data-icon="/" id="analysis_board" href="https://lichess.org/analysis" target="_blank" rel="noopener noreferrer" data-import-prompt="<%= dgettext "study", "Import the downloaded PGN in Lichess to analyze this chapter." %>" title="<%= dgettext "study", "Analyze this position with the Lichess Analysis Board" %>"><%= dgettext "study", "Analyze position" %></a>
  </div>
</div>
    <%= if @study.training_kind == "tactics" do %>
      <div id="study_tactics_failure" class="study-primary-actions" hidden>
        <button type="button" id="study_tactics_retry"><%= dgettext("study", "Try again") %></button>
        <button type="button" id="study_tactics_solution" class="secondary"><%= dgettext("study", "View solution") %></button>
      </div>
    <% end %>
    <nav id="study_move_navigation" class="study-move-navigation" :class="{ 'study-move-navigation--reading': reading }" aria-label="<%= dgettext("study", "Move navigation") %>">
      <button type="button" id="study_previous_move" disabled aria-label="<%= dgettext("study", "Previous move") %>" title="<%= dgettext("study", "Previous move") %>">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="m15 6-6 6 6 6" /></svg>
      </button>
      <button type="button" id="study_next_move" disabled aria-label="<%= dgettext("study", "Next move") %>" title="<%= dgettext("study", "Next move") %>">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="m9 6 6 6-6 6" /></svg>
      </button>
    </nav>
    </div>
  </div>  
  <div class="sidebar">
    <div class="sidebar_innercontainer">
      <div class="study-feedback" role="status" aria-live="polite" aria-atomic="true" data-dismiss="<%= dgettext("study", "Dismiss notification") %>" aria-label="<%= dgettext("study", "Move feedback") %>">
        <%= render ListudyWeb.ComponentView, "infoboxes.html" %>
      </div>

      <div class="sidebar_padded">
        <%= render "_sparring.html" %>
        <section class="study-reading-tree" x-show="reading" x-cloak aria-label="<%= dgettext("study", "Chapter moves") %>">
          <div id="study_moves_heading" class="study-moves-heading">
            <h3><%= dgettext("study", "Moves") %></h3>
          </div>
          <div class="study-tree-columns" aria-hidden="true">
            <span>#</span><span><%= dgettext("study", "White") %></span><span><%= dgettext("study", "Black") %></span>
          </div>
          <div id="study_read_moves" hidden></div>
        </section>

        
        <!-- Active session feedback -->
        <div class="study-session-progress">
          <div class="option_item_progressbar" style="width: 100%;">
        
            <p id="failed_positions_status" role="status" hidden></p>
        
            <p id="smart_run_status" class="study-weak-run-status" aria-live="polite" hidden></p>
            <p id="study_session_counter" class="study-session-counter" hidden></p>
            <section id="study_session_end" class="study-session-end" hidden aria-labelledby="study_session_end_title">
              <h3 id="study_session_end_title" tabindex="-1"><%= dgettext("study", "Session finished") %></h3>
              <p id="study_session_result"></p>
              <div class="study-session-end-actions">
                <button type="button" id="study_session_continue" class="practice-primary"><%= dgettext("study", "Continue practicing") %></button>
                <button type="button" id="study_session_finish" class="secondary"><%= dgettext("study", "Finish") %></button>
              </div>
            </section>
            <p id="weak_run_status" class="study-weak-run-status" hidden></p>
          </div>
        </div>

        <div class="study-comment-panel" :class="{ 'study-comments-expanded': expanded }">
          <div id="comments" class="study_comments" x-ref="comments"></div>
          <button type="button" class="study-read-comment-toggle" x-cloak
                  x-show="reading && (overflowing || expanded)" :aria-expanded="expanded"
                  aria-controls="comments" @click="expanded = !expanded">
            <span x-show="!expanded"><%= dgettext("study", "Show more") %></span>
            <span x-show="expanded"><%= dgettext("study", "Show less") %></span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>




<%= render ListudyWeb.ComponentView, "ui_modal.html", id: "study_settings_dialog", title_id: "study_settings_title", title: dgettext("study", "Settings"), modal_class: "study-training-modal", animated: false, body: render("_study_settings.html", study: @study) %>

<%= render ListudyWeb.ComponentView, "ui_modal.html", id: "study_sparring_history_dialog", title_id: "sparring_history_title", title: dgettext("study", "Sparring history"), modal_class: "study-training-modal study-sparring", animated: false, body: render("_sparring_history.html") %>

<%= render ListudyWeb.ComponentView, "ui_modal.html", id: "study_info_dialog", title_id: "study_info_title", title: dgettext("study", "Study details"), modal_class: "study-training-modal study-about", animated: false, body: render("_study_info.html", assigns) %>
<%= render "_collection_modal.html", conn: @conn %>


<link rel="stylesheet" href="<%= Routes.static_path(@conn, "/css/chessground.css") %>"/>
<script defer type="text/javascript" src="<%= study_script_path(@conn) %>"></script>
<script <%= raw ListudyWeb.Plugs.CSP.put_nonce(@conn) %>>
  /*
   * "Cleans" pgn files, 
   * remove non standard characters
   * replace some (but not all) of the html escapting
  */
  function clean_pgn(pgn) {
    pgn = pgn.replace(/½/g, '1/2');
    pgn = pgn.replace(/&gt;/g, '>');
    pgn = pgn.replace(/&lt;/g, '<');
    pgn = pgn.replace(/&quot;/g, '"');
    pgn = pgn.replace(/&#39;/g, "'");
    // U+FEFF ZERO WIDTH NO-BREAK SPACE
    // No idea why they are in some pgns but they break the parser 
    // https://github.com/ArneVogel/listudy/issues/35
    pgn = pgn.replace(/\ufeff/g, ''); 
    pgn = pgn.replace(/\)/g, ' ) ');
    pgn = pgn.replace(/\(/g, ' ( ');
    pgn = pgn.replace(/\{/g, ' { ');
    pgn = pgn.replace(/\}/g, ' } ');
    pgn = pgn.replace(/0-0-0/g, 'O-O-O');
    pgn = pgn.replace(/0-0/g, 'O-O');
    while (pgn.indexOf("  ") != -1) {
      pgn = pgn.replace(/  /g, ' ');
    }
    return pgn;
  }
  var pgn = clean_pgn(`<%= javascript_escape @study.pgn %>`);
  var color = "<%= @study.color %>";
  var study_id = "<%= @study.slug %>".split("-")[0];
  <%= if Pow.Plug.current_user(@conn) do %>
  var logged_in = true;
  <% else %>
  var logged_in = false;
  <% end %>

  let i18n = {};
  i18n.info_intro = "<%= dgettext "study", "Starting training." %>";
  i18n.no_playable_chapters = "<%= dgettext "study", "Add moves to a chapter to start practicing." %>";
  i18n.read_choose_continuation = "<%= dgettext "study", "Choose a continuation from this chapter." %>";
  i18n.read_start_position = "<%= dgettext "study", "Starting position" %>";
  i18n.read_variation = "<%= dgettext "study", "Variation" %>";
  i18n.tactics_commented_variation = "<%= dgettext "study", "This variation is annotated. Find the main continuation." %>";
  i18n.tactics_trap_failed = "<%= dgettext "study", "Incorrect move. Try again or view the solution." %>";
  i18n.tactics_no_mainline_moves = "<%= dgettext "study", "No moves to practice before the main line's error annotation. Explore this chapter in reading mode." %>";
  i18n.info_arrows = "<%= dgettext "study", "By default arrows will provide hints to show which moves are in this study. Using the options below you can control for how many moves the arrows/hints should stay visible. By default they stay visible until all moves in a position has been played twice. Any non-playable arrow annotations from the study or PGN file will appear as transparent arrows." %>";
  i18n.error_wrong_move = "<%= dgettext "study", "This move is not in the study, try again." %>";
  i18n.success_right_move = "<%= dgettext "study", "Right move!" %>";
  i18n.success_end_of_line = "<%= dgettext "study", "You reached the end of this line." %>";
  i18n.translation_chapter = "<%= dgettext "study", "Chapter" %>";
  i18n.suggestion_first_pgn_arrow = "<%= raw dgettext "study", "The transparent arrows are arrows stored in the study. These don't indicate playable moves but are commonly used to indicate threats, alternative lines, and future ideas." %>";
  i18n.suggestion_first_neglected_move = "<%= dgettext "study", "One of the moves in the position has been played more than others and is marked with a thinner outline. To give all lines equal attention, play one of the other moves!" %>";
  i18n.suggestion_favorite = "<%= dgettext "study", "If you like this study make sure to favorite it to have it listed under Your Studies" %>";
  i18n.suggestion_share = "<%= dgettext "study", "Do you like this study? Share it with your friends." %>";
  i18n.suggestion_account = "<%= dgettext "study", "Create an account to get all the features of Listudy and upload your own studies." %>";
  i18n.suggestion_comment = "<%= dgettext "study", "Do you have feedback, suggestions or do you want to say something nice? Comment on the study below." %>";
  i18n.suggestion_100moves = "<%= dgettext "study", "You learned 100 moves today. Maybe take a break or come back tomorrow to get the full training effect." %>";
  i18n.suggestion_250moves = "<%= raw dgettext "study", "You learned 250 moves today. For the best training effect come back tomorrow. Or don't, I'm just text not a cop." %>";
  i18n.arrows_new2x = "<%= dgettext "study", "Hints: until played 2x" %>";
  i18n.arrows_new5x = "<%= dgettext "study", "Hints: until played 5x" %>";
  i18n.arrows_always = "<%= dgettext "study", "Hints: always on" %>";
  i18n.arrows_hidden = "<%= dgettext "study", "Hints: hidden" %>";
  i18n.arrow_type_both = "<%= raw dgettext "study", "Hints: moves & annotations" %>";
  i18n.arrow_type_playable = "<%= dgettext "study", "Hints: playable moves only" %>";
  i18n.arrow_type_pgn = "<%= dgettext "study", "Hints: annotations only" %>";
  i18n.review_slow = "<%= dgettext "study", "Board reset delay: slow" %>";
  i18n.puzzle_run_off = "<%= dgettext "study", "Puzzle run: off" %>";
  i18n.puzzle_run_next = "<%= dgettext "study", "Puzzle run: next" %>";
  i18n.puzzle_run_smart = "<%= dgettext "study", "Puzzle run: smart" %>";
  i18n.smart_learning = "<%= dgettext "study", "Smart: learning a new line (up to 10 new positions per session)" %>";
  i18n.smart_introduction = "<%= dgettext "study", "New continuation: play the highlighted move. This is learning, not a graded review." %>";
  i18n.smart_introduction_retry = "<%= dgettext "study", "Follow the highlighted move to learn this continuation. No mistake recorded." %>";
  i18n.smart_other_continuation = "<%= dgettext "study", "That move is in your repertoire. Try another continuation for this chain." %>";
  i18n.smart_chain_complete = "<%= dgettext "study", "Practice chain complete!" %>";
  i18n.smart_review = "<%= dgettext "study", "Smart: reviewing a due position" %>";
  i18n.smart_long_review = "<%= dgettext "study", "Smart: checking a longer line" %>";
  i18n.smart_complete = "<%= dgettext "study", "Smart session complete for now" %>";
  i18n.session_labels = {
    session: "<%= dgettext "study", "Session" %>",
    newMoves: "<%= dgettext "study", "new" %>",
    practiced: "<%= dgettext "study", "practiced" %>",
    decisions: "<%= dgettext "study", "decisions" %>",
    sessions: "<%= dgettext "study", "sessions" %>",
    total: "<%= dgettext "study", "Total in this study" %>",
    today: "<%= dgettext "study", "Today" %>",
    lines: "<%= dgettext "study", "Full lines" %>",
    positions: "<%= dgettext "study", "Positions" %>",
    inProgress: "<%= dgettext "study", "In progress" %>",
    goalReached: "<%= dgettext "study", "Session goal reached" %>",
    noWork: "<%= dgettext "study", "Session complete for now" %>",
    saved: "<%= dgettext "study", "Saved" %>",
    finishChain: "<%= dgettext "study", "Finish this chain to complete the session" %>"
  };
  i18n.puzzle_run_random = "<%= dgettext "study", "Puzzle run: random" %>";
  i18n.review_fast = "<%= dgettext "study", "Board reset delay: fast" %>";
  i18n.key_move_enabled = "<%= dgettext "study", "Jump to key move: on" %>";
  i18n.key_move_disabled = "<%= dgettext "study", "Jump to key move: off" %>";
  i18n.slow = "<%= dgettext "study", "slow" %>";
  i18n.fast = "<%= dgettext "study", "fast" %>";
  i18n.medium = "<%= dgettext "study", "medium" %>";
  i18n.instant = "<%= dgettext "study", "instant" %>";
  i18n.comments_when_arrows = "<%= dgettext "study", "Comments: when hints show" %>";
  i18n.comments_always_on = "<%= dgettext "study", "Comments: always on" %>";
  i18n.comments_hidden = "<%= dgettext "study", "Comments: hidden" %>";
  i18n.confirm_reset_progress = "<%= dgettext "study", "Are you sure you want to delete your study progress?" %>";
  i18n.progress_errors = "<%= dgettext "study", "Mistakes" %>";
  i18n.progress_error = "<%= dgettext "study", "mistake" %>";
  i18n.progress_errors_lower = "<%= dgettext "study", "mistakes" %>";
  i18n.progress_correct_moves = "<%= dgettext "study", "Correct moves" %>";
  i18n.progress_recent_accuracy = "<%= dgettext "study", "Recent first-try accuracy" %>";
  i18n.progress_moves_missed = "<%= dgettext "study", "moves missed" %>";
  i18n.progress_last_short = "<%= dgettext "study", "Last" %>";
  i18n.progress_current_short = "<%= dgettext "study", "Current" %>";
  i18n.progress_no_recent_practice = "<%= dgettext "study", "No recent practice" %>";
  i18n.progress_last_practice = "<%= dgettext "study", "Last practice" %>";
  i18n.progress_current_practice = "<%= dgettext "study", "Current practice" %>";
  i18n.progress_practice = "<%= dgettext "study", "practice" %>";
  i18n.progress_practices = "<%= dgettext "study", "practices" %>";
  i18n.progress_incomplete = "<%= dgettext "study", "incomplete" %>";
  i18n.progress_practiced_moves = "<%= dgettext "study", "Moves practiced" %>";
  i18n.progress_coverage = "<%= dgettext "study", "Continuation coverage" %>";
  i18n.progress_full_coverage = "<%= dgettext "study", "Full repertoire coverage" %>";
  i18n.progress_within_depth = "<%= dgettext "study", "Within depth" %>";
  i18n.progress_scope_help = "<%= dgettext "study", "Recall, new continuations and due reviews refer to the selected depth. Deeper reviews keep their original schedules." %>";
  i18n.progress_covered_short = "<%= dgettext "study", "covered" %>";
  i18n.progress_recall = "<%= dgettext "study", "Recall" %>";
  i18n.progress_recall_unknown = "<%= dgettext "study", "Not enough review data yet" %>";
  i18n.progress_graded_reviews = "<%= dgettext "study", "recent graded reviews" %>";
  i18n.progress_new = "<%= dgettext "study", "New continuations" %>";
  i18n.progress_due_continuations = "<%= dgettext "study", "Continuations due for review" %>";
  i18n.progress_due_short = "<%= dgettext "study", "due" %>";
  i18n.progress_coverage_help = "<%= dgettext "study", "Coverage counts continuations answered correctly without help. Full coverage does not mean lasting recall." %>";
  i18n.progress_recall_help = "<%= dgettext "study", "Recall is first-try accuracy in the last 20 graded continuation reviews, excluding each initial encounter. Hints count as misses." %>";
  i18n.progress_clean_moves = "<%= dgettext "study", "Clean moves since last mistake" %>";
  i18n.progress_needs_practice = "<%= dgettext "study", "Needs practice" %>";
  i18n.progress_correct = "<%= dgettext "study", "correct" %>";
  i18n.progress_not_practiced = "<%= dgettext "study", "Not practiced" %>";
  i18n.progress_no_attempts = "<%= dgettext "study", "Not practiced yet" %>";
  i18n.practice_failed_positions = "<%= dgettext "study", "Practice failed positions" %>";
  i18n.failed_position = "<%= dgettext "study", "Position" %>";
  i18n.failed_positions_complete = "<%= dgettext "study", "Failed position practice complete!" %>";
  i18n.weak_run_active = "<%= dgettext "study", "Practicing weak chapters" %>";
  i18n.weak_run_remaining = "<%= dgettext "study", "chapters left" %>";
  i18n.weak_run_complete = "<%= dgettext "study", "Weak chapter practice complete!" %>";
  i18n.spaced_review_due = "<%= dgettext "study", "Review due" %>";
  i18n.spaced_review_next = "<%= dgettext "study", "Next review" %>";
  i18n.spaced_review_active = "<%= dgettext "study", "Reviewing due chapters" %>";
  i18n.spaced_review_complete = "<%= dgettext "study", "Reviews complete for now!" %>";
  i18n.response = "<%= dgettext "study", "response" %>";
  i18n.max_depth = "<%= dgettext "study", "Max depth: " %>";
  i18n.overlay_playable_move = "<%= dgettext "study", "Opaque arrows with a black outline are playable moves" %>";
  i18n.overlay_playable_short = "<%= dgettext "study", "Playable" %>";
  i18n.overlay_pgn_arrow = "<%= dgettext "study", "Transparent arrows come from the study and are not playable" %>";
  i18n.overlay_pgn_arrow_only = "<%= dgettext "study", "Transparent arrows come from the study and are hints only" %>";
  i18n.overlay_frequently_played = "<%= dgettext "study", "Moves that have been played before are shown with a thinner outline" %>";
</script>

<%= render ListudyWeb.ComponentView, "ui_modal.html", id: "progress_modal", title: dgettext("study", "Study Progress"), modal_class: "study-training-modal study-progress-modal", animated: false, body: render("_study_progress.html") %>

</div>
