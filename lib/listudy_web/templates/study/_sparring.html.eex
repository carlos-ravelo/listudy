<section id="study_sparring" class="study-sparring" aria-label="<%= dgettext("study", "Sparring controls and results") %>" hidden>
  <label class="sparring-strength-control"><%= dgettext("study", "Opponent strength") %>
    <select data-sparring="strength" name="sparring_strength" aria-describedby="sparring_strength_help">
      <option value="1"><%= dgettext("study", "Level 1 — Easiest") %></option>
      <option value="2"><%= dgettext("study", "Level 2 — Easy") %></option>
      <option value="3"><%= dgettext("study", "Level 3") %></option>
      <option value="4"><%= dgettext("study", "Level 4") %></option>
      <option value="5"><%= dgettext("study", "Level 5") %></option>
      <option value="6"><%= dgettext("study", "Level 6") %></option>
      <option value="7"><%= dgettext("study", "Level 7") %></option>
      <option value="8"><%= dgettext("study", "Level 8 — Full strength") %></option>
    </select>
  </label>
  <p id="sparring_strength_help" class="sparring-note"><%= dgettext("study", "The level changes your opponent, not the analysis. Levels are practice settings, not Elo ratings.") %></p>
  <label data-sparring="start-control" hidden><%= dgettext("study", "Starting position") %>
    <select data-sparring="start" name="sparring_start_position"
            data-standard="<%= dgettext("study", "Initial position") %>"
            data-custom="<%= dgettext("study", "Custom position") %>"
            data-white="<%= dgettext("study", "White to move") %>"
            data-black="<%= dgettext("study", "Black to move") %>"></select>
  </label>
  <p class="sparring-note"><%= dgettext("study", "All chapters in this study with the same starting position are included.") %></p>

  <div class="sparring-actions" role="group" aria-label="<%= dgettext("study", "Play and review") %>">
    <button type="button" data-sparring="analyze"><%= dgettext("study", "Pause and review") %></button>
    <button type="button" data-sparring="continue" data-theory="<%= dgettext("study", "Play against Stockfish") %>" data-resume="<%= dgettext("study", "Continue playing") %>" data-retry="<%= dgettext("study", "Retry Stockfish") %>"><%= dgettext("study", "Play against Stockfish") %></button>
    <button type="button" data-sparring="retry" hidden><%= dgettext("study", "Retry move") %></button>
  </div>
  <div class="sparring-secondary-actions" role="group" aria-label="<%= dgettext("study", "Session actions") %>">
    <button type="button" data-sparring="resign" data-confirm="<%= dgettext("study", "Resign this game? You can still review and download your results.") %>"><%= dgettext("study", "Resign game") %></button>
  </div>
  <label><input type="checkbox" name="sparring_live_feedback" data-sparring="live" checked> <%= dgettext("study", "Show feedback while playing") %></label>
  <p class="sparring-note"><%= dgettext("study", "An analysis checkpoint appears after every six decisions against the engine. You can continue playing from there.") %></p>
  <section data-sparring="summary" hidden aria-labelledby="sparring_results_title">
    <h2 id="sparring_results_title" tabindex="-1"><%= dgettext("study", "Session results") %></h2>
    <dl class="sparring-metrics">
      <dt><%= dgettext("study", "Theory recalled without help") %></dt><dd data-sparring="theory-score"></dd>
      <dt><%= dgettext("study", "Engine decisions analysed") %></dt><dd data-sparring="engine-score"></dd>
      <dt><%= dgettext("study", "Average winning chances lost (percentage points)") %></dt><dd data-sparring="average"></dd>
    </dl>
    <p data-sparring="outcome"></p>
    <p data-sparring="deviation"></p>
    <p data-sparring="coverage"></p>
    <p><%= dgettext("study", "Select a move to review its position and suggested continuation. Assessments are estimates from limited engine searches.") %></p>
    <div class="sparring-report-scroll">
      <table>
        <caption><%= dgettext("study", "Engine move assessments") %></caption>
        <thead><tr><th scope="col"><%= dgettext("study", "Move") %></th><th scope="col"><%= dgettext("study", "Feedback") %></th><th scope="col"><%= dgettext("study", "Loss (pp)") %></th><th scope="col"><%= dgettext("study", "Suggested continuation") %></th></tr></thead>
        <tbody data-sparring="results"></tbody>
      </table>
    </div>
    <p data-sparring="empty-analysis"><%= dgettext("study", "No moves against the engine have been analysed yet. Your theory results are shown above.") %></p>
    <button type="button" data-sparring="download"><%= dgettext("study", "Download game PGN") %></button>
  </section>
  <details data-sparring="history" hidden>
    <summary><%= dgettext("study", "Previous sessions") %></summary>
    <p class="sparring-note"><%= dgettext("study", "Review or download results from earlier games in this study.") %></p>
    <div data-sparring="recent"></div>
  </details>
  <div class="study-reading-tree"><div data-sparring="moves"></div></div>
</section>
