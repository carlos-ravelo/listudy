<% selected = Enum.find(@openings, &(&1.id == @selected)) %>
<div class="study-opening-picker" x-data="studyOpeningPicker"
     data-selected-id="<%= @selected %>"
     data-selected-name="<%= if selected, do: selected.name, else: dgettext("study", "Choose opening") %>"
     data-opening-names="<%= Jason.encode!(Enum.map(@openings, & &1.name)) %>">
  <%= label @f, :opening_picker_button, dgettext("study", "Opening") %>
  <%= hidden_input @f, :opening_id, value: @selected, "x-ref": "value", "x-bind:value": "selected" %>
  <button type="button" id="study_opening_picker_button" class="study-opening-trigger"
          aria-haspopup="dialog" aria-controls="study_opening_picker" @click="open()">
    <span x-text="name"><%= if selected, do: selected.name, else: dgettext("study", "Choose opening") %></span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m15 15 5 5"/></svg>
  </button>
  <%= error_tag @f, :opening_id %>
  <%= render ListudyWeb.ComponentView, "ui_modal.html", id: "study_opening_picker", title_id: "study_opening_picker_title", title: dgettext("study", "Choose opening"), modal_class: "study-opening-modal", animated: false, body: render("_opening_options.html", openings: @openings) %>
</div>
