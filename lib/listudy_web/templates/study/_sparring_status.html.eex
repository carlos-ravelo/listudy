<div class="sparring-board-status" data-sparring-board-status hidden>
  <span class="sparring-phase" data-sparring="phase" role="status" aria-live="polite" aria-atomic="true"
        data-theory="<%= dgettext("study", "Repertoire") %>"
        data-free="<%= dgettext("study", "Against Stockfish") %>"
        data-review="<%= dgettext("study", "Paused for review") %>"
        data-finished="<%= dgettext("study", "Session finished") %>"
        data-error="<%= dgettext("study", "Engine paused") %>"></span>
  <p class="sparring-status-detail" data-sparring="status" role="status" aria-live="polite"
     data-browsing="<%= dgettext("study", "Browsing the game. Return to the latest position to play.") %>"
     data-evaluation="<%= dgettext("study", "Evaluation (White)") %>"
     data-recommendation="<%= dgettext("study", "Best continuation") %>"
     data-not-analysed="<%= dgettext("study", "This move has not been analysed.") %>"
     data-turn="<%= dgettext("study", "Your move") %>"
     data-thinking="<%= dgettext("study", "Opponent thinking…") %>"
     data-finished="<%= dgettext("study", "Session finished") %>"
     data-review="<%= dgettext("study", "Review your play so far, or continue playing.") %>"
     data-blunder="<%= dgettext("study", "A serious mistake was detected. Review the continuation or retry your move.") %>"
     data-error="<%= dgettext("study", "Analysis unavailable. Retry with Stockfish or restart the line.") %>"
     data-outside="<%= dgettext("study", "Outside your repertoire. Try again or use Hint.") %>"
     data-deviation="<%= dgettext("study", "First move outside your repertoire") %>"
     data-review-move="<%= dgettext("study", "Review move") %>"
     data-assisted="<%= dgettext("study", "Assisted retry") %>"
     data-best="<%= dgettext("study", "Best move") %>"
     data-acceptable="<%= dgettext("study", "Acceptable move") %>"
     data-correct="<%= dgettext("study", "Repertoire move") %>"
     data-grade-blunder="<%= dgettext("study", "Blunder") %>"
     data-inaccuracy="<%= dgettext("study", "Inaccuracy") %>"
     data-mistake="<%= dgettext("study", "Mistake") %>"
     data-loss="<%= dgettext("study", "Estimated winning chances lost (percentage points)") %>"
     data-won="<%= dgettext("study", "You won") %>"
     data-lost="<%= dgettext("study", "You lost") %>"
     data-draw="<%= dgettext("study", "Draw") %>"
     data-resigned="<%= dgettext("study", "You resigned") %>"
     data-unanalysed="<%= dgettext("study", "Analysis pending or unavailable for some moves") %>"
     data-start="<%= dgettext("study", "Starting position") %>"
     data-variation="<%= dgettext("study", "Variation") %>"></p>
</div>
