<div id="collection_modal" class="collection-modal" data-user-id="<%= if user = Pow.Plug.current_user(@conn), do: user.id %>" hidden>
  <div class="collection-dialog" role="dialog" aria-modal="true" aria-labelledby="collection_heading">
    <div class="collection-header">
      <div>
        <h2 id="collection_heading">Collections</h2>
        <p class="collection-subtitle">Your chapters, ready to become a study.</p>
        <select id="collection_selector" aria-label="Active collection" hidden></select>
      </div>
      <button type="button" id="modal_close" class="collection-action collection-close" aria-label="Close collections">×</button>
    </div>
    <div class="collection-workspace">
      <aside class="collection-sidebar">
        <div class="collection-sidebar-heading">Your collections</div>
        <nav id="collection_navigation" aria-label="Collections"></nav>
        <button type="button" id="btn_new_collection" class="collection-action collection-new">+ New collection</button>
      </aside>
      <div class="collection-body">
        <div class="collection-content-heading">
          <div class="collection-title-group">
            <input id="collection_active_name" class="collection-title-input" aria-label="Collection name" title="Click to rename collection" maxlength="100" required>
            <span id="collection_chapter_count" class="collection-subtitle"></span>
          </div>
          <button type="button" id="modal_download" class="collection-action collection-icon" aria-label="Download PGN" title="Download PGN">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M5 16v4h14v-4"/></svg>
          </button>
          <details class="collection-options">
            <summary aria-label="Collection actions" title="Collection actions">•••</summary>
            <div class="collection-options-panel">
              <button type="button" id="modal_clear">Remove all chapters</button>
              <button type="button" id="btn_delete_collection">Delete collection</button>
            </div>
          </details>
        </div>
        <button type="button" id="collection_add_chapter">Add current chapter</button>
        <ul id="collection_list"></ul>
        <form id="collection_study_form" hidden>
          <h3>Create a private study</h3>
          <p>Chapters are copied in this order. Comments and variations are preserved; practice starts fresh.</p>
          <label for="collection_study_title">Study title</label>
          <input id="collection_study_title" name="title" required minlength="3" maxlength="100">
          <label for="collection_study_color">Practice side</label>
          <select id="collection_study_color" name="color"><option value="white">White</option><option value="black">Black</option></select>
          <div><button type="submit" class="button-primary">Create study</button><button type="button" id="collection_cancel_study">Cancel</button></div>
        </form>
      </div>
    </div>
    <div class="collection-footer">
      <div class="collection-sync">
        <span id="collection_save_status" role="status" aria-live="polite"></span>
        <div id="collection_sync_recovery" hidden>
          <button type="button" id="collection_retry_save">Retry save</button>
          <button type="button" id="collection_reload">Reload saved collections</button>
        </div>
      </div>
      <button type="button" id="collection_create_study" class="button button-primary">Create study</button>
    </div>
  </div>
</div>
