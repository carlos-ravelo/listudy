<div id="collection_modal" class="collection-modal" hidden>
  <div class="collection-dialog" role="dialog" aria-modal="true" aria-labelledby="collection_heading">
    <div class="collection-header">
      <div class="collection-actions">
        <h2 id="collection_heading">Collection:</h2>
        <select id="collection_selector" aria-label="Active collection"></select>
      </div>
      <div class="collection-actions">
        <button id="btn_rename_collection" class="collection-action" title="Rename active collection">✏️</button>
        <button id="btn_delete_collection" class="collection-action" title="Delete active collection">🗑️</button>
        <button id="btn_new_collection" class="collection-action" title="Create new collection">➕</button>
      </div>
    </div>
    <div class="collection-body"><ul id="collection_list"></ul></div>
    <div class="collection-footer">
      <button id="modal_download" class="button">Download PGN</button>
      <button id="modal_clear" class="button collection-danger">Clear Current</button>
      <button id="modal_close" class="button">Close</button>
    </div>
  </div>
</div>
