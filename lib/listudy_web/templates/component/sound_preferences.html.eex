    <label for="sound_enable"><%= gettext("Play Sound") %></label>
    <input class="<%= if Map.get(assigns, :bootstrap_ui, false), do: "form-check-input" %>" type="checkbox" checked name="sound_enable" id="sound_enable">

    <label for="sound_volume"><%= gettext("Volume") %></label>
    <input class="<%= if Map.get(assigns, :bootstrap_ui, false), do: "form-range" %>" id="sound_volume" name="sound_volume" type="range" min="0" max="1" step="0.1" value="1">
    <hr>
    <h3><%= gettext("Test Sounds")%></h3>
    <button id="sound_move" class="<%= if Map.get(assigns, :bootstrap_ui, false), do: "btn btn-outline-secondary", else: "secondary" %>"><%= gettext("Move") %></button>
    <button id="sound_capture" class="<%= if Map.get(assigns, :bootstrap_ui, false), do: "btn btn-outline-secondary", else: "secondary" %>"><%= gettext("Capture") %></button>
    <button id="sound_success" class="<%= if Map.get(assigns, :bootstrap_ui, false), do: "btn btn-outline-secondary", else: "secondary" %>"><%= gettext("Success") %></button>
    <button id="sound_error" class="<%= if Map.get(assigns, :bootstrap_ui, false), do: "btn btn-outline-secondary", else: "secondary" %>"><%= gettext("Error") %></button>
