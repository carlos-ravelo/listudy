<div class="home-page">
  <section class="home-welcome" aria-labelledby="home-title">
    <h1 id="home-title"><%= dgettext "index", "Welcome to %{name}!", name: "Listudy" %></h1>
    <p><%= dgettext "index", "Explore chess studies, compare your games with your repertoire, and practice with daily tactics." %></p>
  </section>

  <div class="home-paths">
    <section class="home-path" aria-labelledby="home-studies-title">
      <h2 id="home-studies-title"><%= dgettext "index", "Study chess" %></h2>
      <p><%= dgettext "index", "Explore opening studies and build a repertoire you can practice." %></p>
      <div class="home-path-actions">
        <%= if Pow.Plug.current_user(@conn) do %>
          <%= link (dgettext "index", "Your Studies"), to: Routes.study_path(@conn, :index, @locale), class: "button button-primary" %>
          <%= link (dgettext "index", "🎲 Random Study"), to: Routes.study_path(@conn, :random, locale: @locale), class: "button" %>
          <%= link (dgettext "index", "Explore studies"), to: Routes.search_path(@conn, ListudyWeb.StudySearchLive, @locale), class: "home-text-link" %>
        <% else %>
          <%= link (dgettext "index", "Explore studies"), to: Routes.search_path(@conn, ListudyWeb.StudySearchLive, @locale), class: "button button-primary" %>
        <% end %>
      </div>
    </section>

    <section class="home-path" aria-labelledby="home-analysis-title">
      <h2 id="home-analysis-title"><%= dgettext "index", "Analyze your games" %></h2>
      <p><%= dgettext "index", "Compare a PGN or your Chess.com and Lichess games with your studies." %></p>
      <div class="home-path-actions">
        <%= if Pow.Plug.current_user(@conn) do %>
          <%= link (dgettext "index", "Open game analysis"), to: Routes.analysis_path(@conn, :index), class: "button button-primary" %>
        <% else %>
          <%= link (dgettext "index", "Sign in to analyze"), to: Routes.analysis_path(@conn, :index), class: "button button-primary" %>
          <%= link (dgettext "index", "Create an account"), to: Routes.pow_registration_path(@conn, :new), class: "home-text-link" %>
        <% end %>
      </div>
    </section>
  </div>

  <section class="home-daily" aria-labelledby="home-daily-title">
    <div class="home-daily-heading">
      <div>
        <h2 id="home-daily-title"><%= dgettext "index", "Daily Puzzle" %></h2>
        <p><%= dgettext "index", "A quick position to solve when you have a moment." %></p>
      </div>
      <%= link (dgettext "index", "More tactics"), to: Routes.tactic_path(@conn, :random, @locale), class: "home-text-link" %>
    </div>
    <% next_url = Routes.tactic_path(@conn, :random, @locale) %>
    <%= render ListudyWeb.TacticView, "tactic.html", conn: @conn, tactic: @tactic, next: next_url %>
  </section>
</div>
