<div class="home-page">
  <section class="home-welcome" aria-labelledby="home-title">
    <h1 id="home-title"><%= dgettext "index", "Welcome to %{name}!", name: "Listudy" %></h1>
    <p><%= dgettext "index", "Explore chess studies, compare your games with your repertoire, and practice with daily tactics." %></p>
  </section>

  <div class="home-paths">
    <section class="home-path" aria-labelledby="home-studies-title">
      <h2 id="home-studies-title"><%= dgettext "index", "Study chess" %></h2>
      <p><%= dgettext "index", "Explore opening studies and build a repertoire you can practice." %></p>
      <div class="home-path-content">
        <%= if @last_study do %>
          <div class="home-quick-studies">
            <%= link to: Routes.study_path(@conn, :show, @locale, @last_study.slug), class: "home-continue",
                  data: [study_continue: true, study_id: String.split(@last_study.slug, "-") |> hd()] do %>
              <span class="home-continue-label"><%= dgettext "index", "Continue learning study:" %></span>
              <span class="home-continue-title" title="<%= @last_study.title %>"><%= @last_study.title %></span>
            <% end %>
          </div>
        <% end %>
        <%= link gettext("Tactics"), to: Routes.tactics_library_path(@conn, :tactics, @locale), class: "home-text-link home-tactics-link" %>
      </div>
    </section>

    <section class="home-path" aria-labelledby="home-analysis-title">
      <h2 id="home-analysis-title"><%= dgettext "index", "Analyze your games" %></h2>
      <p><%= emphasize_analysis_sources(dgettext("index", "Compare a PGN or your Chess.com and Lichess games with your studies.")) %></p>
      <div class="home-path-actions">
        <%= if Pow.Plug.current_user(@conn) do %>
          <%= link (dgettext "index", "Open game analysis"), to: Routes.analysis_path(@conn, :index), class: "button button-primary" %>
        <% else %>
          <%= link (dgettext "index", "Sign in to analyze"), to: Routes.analysis_path(@conn, :index), class: "button button-primary" %>
          <%= link (dgettext "index", "Create an account"), to: Routes.pow_registration_path(@conn, :new), class: "home-text-link" %>
        <% end %>
      </div>
    </section>

    <section class="home-card home-daily-studies" aria-labelledby="home-daily-studies-title">
      <h2 id="home-daily-studies-title"><%= dgettext "index", "Your daily studies" %></h2>
      <%= if @daily_studies != [] do %>
        <div class="home-daily-scroll" role="region" aria-labelledby="home-daily-studies-title" <%= if length(@daily_studies) > 6, do: raw("tabindex=\"0\"") %>>
          <ul class="home-daily-studies-list">
            <%= for study <- @daily_studies do %>
              <% last = @last_study && study.id == @last_study.id %>
              <li>
                <%= link to: Routes.study_path(@conn, :show, @locale, study.slug), class: "home-daily-study",
                      data: [study_continue: true, study_id: String.split(study.slug, "-") |> hd(), last_study: last] do %>
                  <span class="home-daily-study-copy">
                    <span class="home-daily-study-title" title="<%= study.title %>"><%= study.title %></span>
                    <%= if last || study.id == @most_used do %>
                      <span class="home-daily-study-signals">
                        <%= if last do %>
                          <span class="home-daily-study-recent"><%= dgettext "index", "Last study" %></span>
                        <% end %>
                        <%= if study.id == @most_used do %>
                          <span class="home-daily-study-most-used" title="<%= dgettext "index", "Most training time" %>"><%= dgettext "index", "Most used" %></span>
                        <% end %>
                      </span>
                    <% end %>
                  </span>
                  <%= if study.color in ["white", "black"] do %>
                    <span class="home-daily-study-color" role="img" aria-label="<%= if study.color == "white", do: dgettext("study", "White"), else: dgettext("study", "Black") %>">
                      <span aria-hidden="true"><%= if study.color == "white", do: "♔", else: "♚" %></span>
                    </span>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
        <%= link (dgettext "index", "View all"), to: Routes.study_path(@conn, :index, @locale), class: "home-text-link home-daily-studies-footer" %>
      <% else %>
        <div class="home-daily-studies-empty">
          <%= if Pow.Plug.current_user(@conn) do %>
            <p><%= dgettext "index", "Choose studies for your daily practice." %></p>
            <%= link (dgettext "index", "Your Studies"), to: Routes.study_path(@conn, :index, @locale), class: "home-text-link" %>
          <% else %>
            <p><%= dgettext "index", "Sign in to see your daily studies." %></p>
            <%= link gettext("Sign in"), to: Routes.pow_session_path(@conn, :new, request_path: Routes.study_path(@conn, :index, @locale)), class: "home-text-link" %>
          <% end %>
        </div>
      <% end %>
    </section>

    <section class="home-card home-daily" aria-labelledby="home-daily-title">
      <div class="home-daily-heading">
        <h2 id="home-daily-title"><%= dgettext "index", "Daily Puzzle" %></h2>
        <%= link (dgettext "index", "More tactics"), to: Routes.tactics_library_path(@conn, :tactics, @locale), class: "home-text-link" %>
      </div>
      <% next_url = Routes.tactic_path(@conn, :random, @locale) %>
      <%= render ListudyWeb.TacticView, "tactic.html", conn: @conn, tactic: @tactic, next: next_url %>
    </section>
  </div>
</div>
