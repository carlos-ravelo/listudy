<%= render ListudyWeb.ComponentView, "visualization_guide.html", conn: @conn, locale: @locale,
  title: gettext("Pieceless Tactics"),
  intro: dgettext("tactics", "Picture the hidden pieces using the piece list, then play the solution on the board."),
  play: Routes.pieceless_tactic_path(@conn, :random, @locale),
  steps: [
    {dgettext("tactics", "Build the position"), dgettext("tactics", "The piece list gives each piece and its starting square. Some or all pieces are hidden, depending on your settings.")},
    {dgettext("tactics", "Play from memory"), dgettext("tactics", "Select the square of a hidden piece and its destination, just as you would on a visible board.")},
    {dgettext("tactics", "Track the reply"), dgettext("tactics", "Use the move history to follow captures and replies. The piece list describes the starting position, not the current one.")}
  ], image: "/images/features/pieceless/moves.png",
  image_alt: dgettext("tactics", "Board used to play moves with hidden pieces"),
  caption: dgettext("tactics", "Legal destination hints are optional. Enable them in settings when you need help.") %>
