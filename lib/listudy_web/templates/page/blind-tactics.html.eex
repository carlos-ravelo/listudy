<%= render ListudyWeb.ComponentView, "visualization_guide.html", conn: @conn, locale: @locale,
  title: gettext("Blind Tactics"),
  intro: dgettext("tactics", "Read the moves, picture the current position, then solve while the board stays frozen."),
  play: Routes.blind_tactic_path(@conn, :random, @locale),
  steps: [
    {dgettext("tactics", "Read the sequence"), dgettext("tactics", "The diagram shows an earlier position. Play the listed moves in your mind to reach the position to solve.")},
    {dgettext("tactics", "Play from memory"), dgettext("tactics", "Click the square where your piece is now, then its destination. The displayed pieces stay in their original places.")},
    {dgettext("tactics", "Track the reply"), dgettext("tactics", "Opponent replies appear in the move list. Keep updating your mental board until you solve the puzzle.")}
  ], image: "/images/features/blind/board-state.png",
  image_alt: dgettext("tactics", "Frozen board and the position imagined after the listed moves"),
  caption: dgettext("tactics", "The board stays frozen; follow the move list to track the current position.") %>
