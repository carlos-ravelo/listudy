<section class="admin-dashboard">
  <h1><%= gettext("Puzzle imports") %></h1>
  <p><%= gettext("Upload the official Lichess CSV or CSV.zst. Each import selects up to 50,000 puzzles across rating bands and themes. Existing source identifiers are skipped.") %></p>
  <p><%= gettext("Imports run in the background. Refresh this page for their status. Large files can be queued on the server with mix puzzles.import FILE.csv.zst.") %></p>
  <%= form_for @conn, Routes.puzzle_catalog_path(@conn, :create), [as: :import, multipart: true], fn f -> %>
    <%= label f, :file, gettext("Lichess CSV (up to 8 MB; use the server command for larger files)") %>
    <%= file_input f, :file, accept: ".csv,.zst", required: true %>
    <%= submit gettext("Queue import") %>
  <% end %>
  <table>
    <thead><tr><th><%= gettext("File") %></th><th><%= gettext("Status") %></th><th><%= gettext("Processed") %></th><th><%= gettext("Inserted") %></th><th><%= gettext("Rejected source rows") %></th><th><%= gettext("Error") %></th></tr></thead>
    <tbody><%= for job <- @imports do %>
      <tr><td><%= job.filename %></td><td><%= job.status %></td><td><%= job.processed %></td><td><%= job.inserted %></td><td><%= job.skipped %></td><td><%= job.error %></td></tr>
    <% end %></tbody>
  </table>
</section>
