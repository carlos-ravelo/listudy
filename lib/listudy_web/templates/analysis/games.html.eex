<div class="analysis-games-page analysis-workspace practice-page">
  <%= link "← Analysis overview", to: Routes.analysis_path(@conn, :index) %>
  <h1>Imported games</h1>
  <p class="analysis-games-intro">Your games, compared with your repertoire at the last sync.</p>

  <%= form_for @conn, Routes.analysis_path(@conn, :games), [method: :get, class: "analysis-games-filters practice-panel"], fn _f -> %>
    <label>Period
      <select name="period" aria-label="Period">
        <option value="all" <%= if @library.period == "all", do: "selected" %>>All dates</option>
        <option value="last_week" <%= if @library.period == "last_week", do: "selected" %>>Last week</option>
        <option value="last_month" <%= if @library.period == "last_month", do: "selected" %>>Last month</option>
      </select>
    </label>
    <label>Repertoire comparison
      <select name="status" aria-label="Repertoire comparison">
        <option value="">Any result</option>
        <%= for status <- ~w(deviation match ambiguous out_of_scope error) do %>
          <option value="<%= status %>" <%= if @library.status == status, do: "selected" %>><%= analysis_status_label(status) %></option>
        <% end %>
      </select>
    </label>
    <details class="analysis-games-more" data-game-filters-more>
      <summary>More filters<%= if @library.platform || @library.study_id, do: " (#{Enum.count([@library.platform, @library.study_id], & &1)})" %></summary>
      <div class="analysis-games-more-panel">
        <label>Platform
          <select name="platform" aria-label="Platform">
            <option value="">Both platforms</option>
            <option value="lichess" <%= if @library.platform == "lichess", do: "selected" %>>Lichess</option>
            <option value="chess_com" <%= if @library.platform == "chess_com", do: "selected" %>>Chess.com</option>
          </select>
        </label>
        <label>Study
          <select name="study_id" aria-label="Study">
            <option value="">All studies</option>
            <%= for study <- @library.studies do %>
              <option value="<%= study.id %>" <%= if @library.study_id == study.id, do: "selected" %>><%= study.title %></option>
            <% end %>
          </select>
        </label>
      </div>
    </details>
    <button type="submit" class="practice-primary">Filter games</button>
  <% end %>
  <div class="analysis-games-active-filters">
    <%= if @library.platform do %>
      <%= link analysis_platform_label(@library.platform) <> " ×", to: Routes.analysis_path(@conn, :games, Map.take(@conn.query_params, ["period", "study_id", "status"])), aria: [label: "Remove platform filter" ] %>
    <% end %>
    <%= if @library.study_id do %>
      <% selected_study = Enum.find(@library.studies, &(&1.id == @library.study_id)) %>
      <%= link selected_study.title <> " ×", to: Routes.analysis_path(@conn, :games, Map.take(@conn.query_params, ["platform", "period", "status"])), aria: [label: "Remove study filter: " <> selected_study.title] %>
    <% end %>
    <%= if @library.platform || @library.study_id || @library.status || @library.period != "all" do %>
      <%= link "Reset filters", to: Routes.analysis_path(@conn, :games), class: "analysis-games-reset" %>
    <% end %>
  </div>

  <%= if @library.total == 0 do %>
    <div class="analysis-games-empty practice-panel">
      <%= if @library.has_games do %>
        <h2>No games match these filters</h2>
        <%= link "Reset filters", to: Routes.analysis_path(@conn, :games), class: "button practice-primary" %>
      <% else %>
        <h2>No imported games yet</h2>
        <p>Connect an account or sync games to start comparing them with your repertoire.</p>
        <%= link "Connect or sync games", to: Routes.analysis_path(@conn, :index), class: "button practice-primary" %>
      <% end %>
    </div>
  <% else %>
    <%= if @library.games == [] do %>
      <p class="highlight">This page is no longer available. <%= link "Return to newest games", to: Routes.analysis_path(@conn, :games, Map.take(@conn.query_params, ["platform", "period", "study_id", "status"])) %>.</p>
    <% else %>
      <p class="analysis-games-count">Showing <strong><%= @library.first_number %>–<%= @library.last_number %></strong> of <strong><%= @library.total %></strong> matching imported games</p>
      <ol class="analysis-games-list" start="<%= @library.first_number %>">
        <%= for game <- @library.games do %>
          <%
            summaries = Map.get(@library.summaries, game.id, [])
            visible = Enum.filter(summaries, fn summary ->
              (is_nil(@library.study_id) or summary.study_id == @library.study_id) and
                (is_nil(@library.status) or summary.status == @library.status)
            end)
            visible = if is_nil(@library.study_id) and is_nil(@library.status) and Enum.any?(visible, &(&1.status in ["deviation", "match", "ambiguous"])) do
              Enum.filter(visible, &(&1.status in ["deviation", "match", "ambiguous"]))
            else
              visible
            end
            result = primary_game_result(visible)
            has_other_error = Enum.any?(summaries, &(&1.status == "error")) and
              (is_nil(result) or result.status != "error")
            list_params = Map.take(@conn.query_params, ["platform", "period", "study_id", "status", "cursor", "direction"])
            compare_params = if @library.study_id, do: Map.put(list_params, "compare_study_id", to_string(@library.study_id)), else: list_params
          %>
          <li>
            <a class="analysis-game-row" href="<%= Routes.analysis_path(@conn, :compare_game, game.id, compare_params) %>">
              <span class="analysis-game-primary">
                <span class="analysis-game-heading"><strong><%= game_opponent(game) %></strong><span class="analysis-game-result" aria-label="Game result: <%= game_outcome(game) %>"><%= game_outcome(game) %></span></span>
                <span><%= if game.player_color, do: "You as #{String.capitalize(game.player_color)} · " %><%= analysis_platform_label(game.platform) %> · <time data-local-time datetime="<%= DateTime.to_iso8601(game.played_at) %>"><%= Calendar.strftime(game.played_at, "%d %b %Y, %H:%M UTC") %></time></span>
              </span>
              <span class="analysis-game-summary">
                <%= if result do %>
                  <span class="analysis-status analysis-status-<%= result.status %>"><%= analysis_status_label(result.status) %></span>
                  <%= if result.status in ["deviation", "match", "ambiguous"] do %>
                    <span class="analysis-game-study-name"><%= result.study_title %></span>
                  <% end %>
                <% else %>
                  <span class="analysis-status">Not analyzed for a study</span>
                <% end %>
                <%= if has_other_error do %>
                  <span class="analysis-game-warning">Some studies unavailable</span>
                <% end %>
              </span>
              <span class="analysis-game-open practice-secondary">View comparison</span>
            </a>
          </li>
        <% end %>
      </ol>

      <nav class="analysis-games-pagination" aria-label="Game pages">
        <span>
          <%= if @library.previous_cursor do %>
            <%= link "← Newer games", to: Routes.analysis_path(@conn, :games,
              Map.take(@conn.query_params, ["platform", "period", "study_id", "status"])
              |> Map.merge(%{"cursor" => @library.previous_cursor, "direction" => "newer"})) %>
          <% end %>
        </span>
        <span>
          <%= if @library.next_cursor do %>
            <%= link "Older games →", to: Routes.analysis_path(@conn, :games,
              Map.take(@conn.query_params, ["platform", "period", "study_id", "status"])
              |> Map.put("cursor", @library.next_cursor)) %>
          <% end %>
        </span>
      </nav>
    <% end %>
  <% end %>
</div>
<script defer src="<%= Routes.static_path(@conn, "/js/analysis_games.js") %>"></script>
