<link rel="stylesheet" href="<%= Routes.static_path(@conn, "/css/chessground.css") %>"/>
<div class="analysis-result-container">
  <%= link "← Back to Analysis", to: Routes.analysis_path(@conn, :index), class: "button" %>
  <h2>Analysis Result: <%= @study.title %></h2>
  <%= link "Go to chapter: #{@result["chapter"]}",
    to: Routes.study_path(@conn, :show, @conn.assigns[:locale] || "en", @study.slug,
      chapter_index: @result["chapter_index"]), class: "button" %>

  <%= if @result["transposed"] do %>
    <p>This game entered the chapter through a different move order after <%= @result["entry_ply"] %> half-moves.</p>
  <% end %>
  <%= if @result["deviation"] do %>
    <p><strong><%= if @deviator_color == @study.color, do: "You deviated.", else: "Opponent deviated." %></strong>
      Played <%= @result["played"] %>; this chapter expected <%= Enum.join(@result["expected"], " / ") %>.</p>
  <% else %>
    <p><%= if @result["reason"] == "book_ended", do: "The game reached the end of this chapter's stored line.", else: "The game ended in a position from this chapter." %></p>
  <% end %>
  <%= if @result["earlier_departures"] != [] do %>
    <details>
      <summary>Earlier departures from the stored move order</summary>
      <ul>
        <%= for departure <- @result["earlier_departures"] do %>
          <li>Half-move <%= departure["ply"] + 1 %>: played <%= departure["played"] %>, stored <%= Enum.join(departure["expected"], " / ") %>. The game later rejoined the chapter.</li>
        <% end %>
      </ul>
    </details>
  <% end %>
  <div id="quick-analysis-board" class="cg-wrap analysis-result-board"
    data-pgn="<%= @pgn_text %>" data-error-fen="<%= @result["fen"] %>"
    data-ply="<%= @result["ply"] %>" data-expected="<%= Enum.join(@result["expected"], ",") %>"
    data-played="<%= @result["played"] %>"></div>
  <div class="analysis-result-navigation">
    <button id="btn-prev">← Prev</button>
    <button id="btn-next">Next →</button>
  </div>
</div>
<script defer src="<%= Routes.static_path(@conn, "/js/quick_result.js") %>"></script>
