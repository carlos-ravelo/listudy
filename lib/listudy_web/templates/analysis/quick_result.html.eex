<% groups = comparison_groups(@choices) %>
<link rel="stylesheet" href="<%= Routes.static_path(@conn, "/css/chessground.css") %>"/>
<div id="analysis-comparison" class="analysis-result-container"
  data-comparisons="<%= Jason.encode!(Enum.map(groups, &Map.take(&1, [:result, :color]))) %>">
  <%= link "← Back to Analysis", to: Routes.analysis_path(@conn, :index), class: "button" %>
  <h1>Your game and repertoire</h1>
  <p>
    <%= length(@choices) %> matching <%= if length(@choices) == 1, do: "chapter", else: "chapters" %>.
    <%= if length(groups) == 1 do %>
      <%= if length(@choices) > 1, do: "They give the same comparison for this game; their later continuations may differ." %>
    <% else %>
      <%= length(groups) %> different comparisons fit equally well. Select one to explore it on the board.
    <% end %>
  </p>

  <div class="analysis-comparison-layout">
    <section class="analysis-game" aria-label="Uploaded game">
      <div id="analysis-replay-error" class="error infoBox" role="alert" hidden></div>
      <div id="quick-analysis-board" class="cg-wrap analysis-result-board" data-pgn="<%= @pgn_text %>" aria-label="Game board"></div>
      <div class="analysis-result-navigation" aria-label="Game navigation">
        <button type="button" id="btn-prev" disabled>← Previous</button>
        <button type="button" id="btn-comparison" disabled>Comparison position</button>
        <button type="button" id="btn-next" disabled>Next →</button>
      </div>
      <p id="analysis-board-status" class="analysis-board-status" aria-live="polite"></p>
      <details class="analysis-game-moves">
        <summary>Game moves</summary>
        <div id="analysis-moves" aria-label="Move list"></div>
      </details>
      <div id="analysis-outcomes" aria-live="polite">
        <%= for {group, index} <- Enum.with_index(groups) do %>
          <%= render "_comparison_outcome.html", group: group, index: index %>
        <% end %>
      </div>
      <noscript><p>Enable JavaScript to replay your game and switch comparisons. Chapter links are available below.</p></noscript>
    </section>

    <aside class="analysis-matches" aria-labelledby="analysis-matches-heading">
      <h2 id="analysis-matches-heading">Matching chapters</h2>
      <%= for {group, index} <- Enum.with_index(groups) do %>
        <section class="analysis-match-group" data-match-group="<%= index %>">
          <button type="button" class="analysis-group-choice" data-select-group="<%= index %>"
            aria-pressed="<%= if index == 0, do: "true", else: "false" %>"
            aria-controls="analysis-outcome-<%= index %>" disabled>
            <strong><%= comparison_title(group.result) %></strong>
            <span><%= length(group.chapters) %> <%= if length(group.chapters) == 1, do: "chapter", else: "chapters with this comparison" %></span>
          </button>
          <details class="analysis-chapter-list" <%= if length(group.chapters) == 1, do: "open" %>>
            <summary>View <%= length(group.chapters) %> <%= if length(group.chapters) == 1, do: "chapter", else: "chapters" %></summary>
            <ul>
              <%= for {study, result} <- group.chapters do %>
                <li>
                  <span class="analysis-study-name"><%= String.replace(study.title, "_", " ") %></span>
                  <strong>Chapter <%= result["chapter_index"] + 1 %>: <%= result["chapter"] %></strong>
                  <%= link "Open study chapter ↗", to: chapter_path(@conn, study, result), target: "_blank", rel: "noopener" %>
                </li>
              <% end %>
            </ul>
          </details>
        </section>
      <% end %>
      <p class="analysis-match-help">Opening a study chapter uses a new tab, so you can keep this comparison open.</p>
    </aside>
  </div>
</div>
<script defer src="<%= Routes.static_path(@conn, "/js/quick_result.js") %>"></script>
