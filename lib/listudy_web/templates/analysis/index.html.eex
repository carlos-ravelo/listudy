<div class="whole">
  <h2>Analyze Games</h2>

  <%
    accounts = [
      %{key: "lichess", name: "Lichess", username: @current_user.lichess_username,
        count: @lichess_count},
      %{key: "chess_com", name: "Chess.com", username: @current_user.chess_com_username,
        count: @chesscom_count}
    ]
  %>

  <section class="analysis-accounts" data-sync-status-url="<%= Routes.analysis_path(@conn, :sync_status) %>">
    <h3>Game sources</h3>
    <div class="analysis-account-grid">
      <%= for account <- accounts do %>
        <% sync = @syncs[account.key] %>
        <article class="analysis-account-card" data-sync-platform="<%= account.key %>" data-sync-state="<%= if sync, do: sync.status, else: "idle" %>">
          <div class="analysis-account-heading">
            <h4><%= account.name %></h4>
            <%= if account.username do %>
              <span class="analysis-account-user">✓ <%= account.username %></span>
            <% else %>
              <span class="analysis-account-user analysis-account-user-empty">Not connected</span>
            <% end %>
          </div>

          <%= if account.username do %>
            <p class="analysis-account-count">
              <%= if account.count > 0 do %>
                <%= link "#{account.count} imported games", to: Routes.analysis_path(@conn, :games, platform: account.key) %>
              <% else %>
                0 imported games
              <% end %>
            </p>
            <div class="analysis-sync-status" role="status" aria-live="polite">
              <strong class="analysis-sync-badge analysis-sync-badge-<%= if sync, do: sync.status, else: "idle" %>" data-sync-badge>
                <%= case sync && sync.status do
                  "running" -> "Syncing"
                  "completed" -> "Sync complete"
                  "failed" -> "Sync failed"
                  _ -> "Not synced yet"
                end %>
              </strong>
              <span data-sync-details><%= if sync, do: sync.details %></span>
            </div>
            <%= if sync && sync.status != "running" do %>
              <p class="analysis-account-meta"><%= if sync.status == "failed", do: "Last attempt", else: "Last checked" %> <time datetime="<%= NaiveDateTime.to_iso8601(sync.updated_at) %>Z"><%= Calendar.strftime(sync.updated_at, "%d %b %Y, %H:%M UTC") %></time></p>
            <% end %>
          <% end %>

          <%= form_for :analysis, Routes.analysis_path(@conn, :sync), [class: "analysis-account-actions"], fn f -> %>
            <%= hidden_input f, :platform, value: account.key %>
            <%= if account.username do %>
              <%= submit "Sync games", class: "button button-primary", disabled: sync && sync.status == "running" %>
              <%= unless sync && sync.status == "running" do %>
                <%= link "Disconnect", to: Routes.analysis_path(@conn, :disconnect, platform: account.key), method: :post, class: "analysis-disconnect" %>
              <% end %>
            <% else %>
              <%= text_input f, :username, placeholder: "#{account.name} username", required: true, "aria-label": "#{account.name} username" %>
              <%= submit "Connect", class: "button button-primary" %>
            <% end %>
          <% end %>
        </article>
      <% end %>
    </div>
  </section>

  <section class="analysis-library" aria-label="Imported games">
    <div>
      <h3>Game library</h3>
      <p><strong><%= @lichess_count + @chesscom_count %></strong> imported games</p>
    </div>
    <%= link "Browse games →", to: Routes.analysis_path(@conn, :games), class: "analysis-library-link" %>
  </section>

  <details class="analysis-quick-pgn">
    <summary>Analyze a PGN</summary>
    <div class="mt-4">
      <%= form_for @conn, Routes.analysis_path(@conn, :quick_analyze), fn f -> %>
        <div class="field">
          <label class="label">Paste a PGN</label>
          <div class="control">
            <%= textarea f, :pgn, class: "textarea", rows: 6, placeholder: "1. e4 c5 2. Nf3..." %>
          </div>
        </div>
        <div class="control mt-2">
          <%= submit "Analyze Game", class: "button is-primary" %>
        </div>
      <% end %>
    </div>
  </details>

  <section class="analysis-overview-studies">
    <div class="analysis-section-heading">
      <h3>Repertoire overview</h3>
      <div class="analysis-repertoire-filter">
        <label for="time-filter">Period</label>
        <select id="time-filter">
          <option value="all" <%= if @filter == "all", do: "selected" %>>All time</option>
          <option value="last_week" <%= if @filter == "last_week", do: "selected" %>>Last week</option>
          <option value="last_month" <%= if @filter == "last_month", do: "selected" %>>Last month</option>
        </select>
      </div>
    </div>
    <div class="analysis-overview-grid">
      <%= for stat <- @studies_stats do %>
        <article class="analysis-overview-card">
          <div>
            <h4><%= stat.study.title %></h4>
            <p class="analysis-overview-primary"><strong><%= stat.deviations %></strong> <span><%= if stat.deviations == 1, do: "game with a deviation", else: "games with deviations" %></span></p>
            <p class="analysis-overview-secondary"><strong><%= stat.matches %></strong> matched without deviation <span aria-hidden="true">·</span> <strong><%= stat.total_games %></strong> checked</p>
          </div>

          <%= if stat.deviations > 0 do %>
            <%= link "Train mistakes", to: Routes.analysis_path(@conn, :train, stat.study.id, filter: @filter), class: "button button-primary" %>
          <% end %>

          <%= if stat.ambiguous > 0 or stat.errors > 0 do %>
            <div class="analysis-overview-notices">
              <%= if stat.ambiguous > 0 do %>
                <%= link "#{stat.ambiguous} #{if stat.ambiguous == 1, do: "game matches", else: "games match"} multiple chapters", to: Routes.analysis_path(@conn, :games, study_id: stat.study.id, status: "ambiguous", period: @filter) %>
              <% end %>
              <%= if stat.errors > 0 do %>
                <%= link "#{stat.errors} #{if stat.errors == 1, do: "analysis error", else: "analysis errors"}", to: Routes.analysis_path(@conn, :games, study_id: stat.study.id, status: "error", period: @filter) %>
              <% end %>
            </div>
          <% end %>
        </article>
      <% end %>
    </div>
  </section>
</div>

<script defer type="text/javascript" src="/js/analysis_overview.js"></script>
