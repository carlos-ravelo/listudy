<link rel="stylesheet" href="<%= Routes.static_path(@conn, "/css/chessground.css") %>"/>


<div class="training-container analysis-workspace" style="max-width: 800px; margin: 0 auto; padding: 2rem 0;">

  <div style="margin-bottom: 2.5rem;">
    <div style="margin-bottom: 0.5rem;">
      <%= link "← Back to Overview", to: Routes.analysis_path(@conn, :index), class: "analysis-back-link" %>
    </div>
    <h2 style="margin: 0; line-height: 1.2;">
      Training Mistakes: <span><%= @study.title %></span>
    </h2>
  </div>

  <div style="width: min(100%, 500px); margin: 0 auto 0.5rem auto; display: flex; justify-content: flex-end;">
    <select id="time-filter" aria-label="Time period">
      <option value="all" <%= if @filter == "all", do: "selected" %>>All time</option>
      <option value="last_week" <%= if @filter == "last_week", do: "selected" %>>Last week</option>
      <option value="last_month" <%= if @filter == "last_month", do: "selected" %>>Last month</option>
    </select>
  </div>

  <div
    id="chess-training-board"
    class="cg-wrap"
    style="width: min(100%, 500px); aspect-ratio: 1 / 1; height: auto; margin: 0 auto;"
    data-mistakes="<%= @mistakes_json %>">
  </div>

  <div id="training-controls" style="text-align: center; margin-top: 2rem;">
    <h3 id="training-status" style="margin-bottom: 1rem;">Preparing positions...</h3>
    <p id="mistake-info"></p>
    <div id="mistakes-pagination" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 1rem; margin-bottom: 1rem;"></div>
    <div style="display: flex; gap: 0.5rem; justify-content: center; margin-top: 1rem;">
      <button id="hint-btn" class="button button-outline" style="margin: 0;">Hint</button>
      <button id="solve-btn" class="button button-outline" style="margin: 0;">Show Answer</button>
      <button id="next-mistake-btn" class="button button-primary" style="display: none; margin: 0;">Next Position</button>
    </div>
    <div id="training-chapters" class="training-chapters" aria-label="Study chapters" hidden></div>
    <%= if @chapter_error do %>
      <p class="training-chapters-error"><%= @chapter_error %></p>
    <% end %>
  </div>
</div>

<script defer type="text/javascript" src="/js/train_mistakes.js?v=training-3"></script>
