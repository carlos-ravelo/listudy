<div class="analysis-games-page">
  <%= link "← Imported games", to: Routes.analysis_path(@conn, :games) %>
  <h1><%= @game.white_player || "White" %> – <%= @game.black_player || "Black" %></h1>
  <p><%= analysis_platform_label(@game.platform) %> · <%= Calendar.strftime(@game.played_at, "%d %b %Y, %H:%M UTC") %></p>
  <p><%= link "Compare with repertoire", to: Routes.analysis_path(@conn, :compare_game, @game.id), class: "button" %></p>

  <h2>Saved study results</h2>
  <%= if @summaries == [] do %>
    <p>This game has no saved study result yet. You can still compare it with your current repertoire.</p>
  <% else %>
    <ul class="analysis-game-study-results">
      <%= for result <- @summaries do %>
        <li>
          <strong><%= result.study_title %></strong>
          <span class="analysis-status analysis-status-<%= result.status %>"><%= analysis_status_label(result.status) %></span>
          <span>Reached <%= result.depth %> half-moves in the game.</span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <details class="analysis-game-pgn">
    <summary>View PGN</summary>
    <textarea readonly aria-label="Game PGN" rows="12"><%= @game.pgn %></textarea>
  </details>
</div>
