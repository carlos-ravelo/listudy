<div class="training-workspace training-daily">
  <%= render ListudyWeb.ComponentView, "training_header.html", conn: @conn, locale: @locale, title: dgettext("tactics", "Daily Chess Puzzle") %>
  <%= render ListudyWeb.TacticView, "tactic.html", conn: @conn, tactic: @tactic,
        next: Routes.tactics_library_path(@conn, :tactics, @locale), next_label: dgettext("tactics", "Practice your tactics") %>
</div>
