<div data-training-kind="tactics" class="training-workspace training-tool-page">
<%= render ListudyWeb.ComponentView, "training_header.html", conn: @conn, locale: @locale, title: dgettext("tactics", "Custom Tactic") %>
<div class="training-tool-intro">
  <p><%= dgettext("tactics", "For your own practice, create a tactics collection on the board or import a PGN. Use the sharing tool below to embed a single puzzle on another website.") %></p>
  <div class="training-actions">
    <%= link dgettext("study", "Start on the board"), to: Routes.study_path(@conn, :new, @locale, source: "blank", kind: "tactics"), class: "button continue_button" %>
    <%= link dgettext("study", "Import PGN"), to: Routes.study_path(@conn, :new, @locale, kind: "tactics") %>
  </div>
</div>
<div class="with_sidebar custom-tactic-preview">
  <div id="game_container" class="sidebar_main">
    <div class="study-board-frame"><%= render ListudyWeb.ComponentView, "chessground.html" %></div>
  </div>
  <div class="sidebar">

    <%= render ListudyWeb.ComponentView, "infoboxes.html" %>

    <%= link dgettext("tactics", "Practice your tactics"), to: Routes.tactics_library_path(@conn, :tactics, @locale), id: "next", class: "hidden button continue_button" %>
    <details class="hidden" id="solution">
        <summary><%= dgettext("tactics", "Solution") %></summary>
        <span id="solution_moves"></span>
    </details>
  </div>
</div>

<link rel="stylesheet" href="<%= Routes.static_path(@conn, "/css/chessground.css") %>"/>
<script defer type="text/javascript" src="<%= Routes.static_path(@conn, "/js/tactics.js") %>"></script>
<form class="hidden">
  <input type="text" id="fen" value="">
  <input type="text" id="color" value="">
  <input type="text" id="moves" value="">
  <input type="text" id="last_move" value="">
</form>
<script <%= raw ListudyWeb.Plugs.CSP.put_nonce(@conn) %>>
<%!-- CAREFUL! the hash is user supplies and its values can only be used in --%>
<%!-- save javascript functions! --%>
function clean_input(i) {
  if (i == undefined) {
    return "";
  }
  // this function is used to remove non wanted characters from the decoded hash
  // probably also remove xss vulnerabilities if input was used in unsafe functions, but
  // this does NOT replace the need to not use the input in unsafe function calls
  return i.replace(/[^a-zA-Z0-9-_#+!= /]/g, '');
}

// atob => base64 decode the hash
let t;
try { t = atob(document.location.hash.slice(1)).split(";"); } catch (_) { t = []; }
let fen = clean_input(t[0]);
let color = clean_input(t[0]).split(" ")[1];
if (color == "b") {
  color = "black";
} else {
  color = "white";
}
let moves = clean_input(t[1]);
let last_move = clean_input(t[2]) || "";
// tactics.js loads the data from the form so we have to populate it
document.getElementById("fen").value = fen;
document.getElementById("color").value = color;
document.getElementById("moves").value = moves;
document.getElementById("last_move").value = last_move;
document.querySelector(".custom-tactic-preview").hidden = !fen;
document.getElementById("solution_moves").innerText = moves;

<%= render ListudyWeb.TacticView, "translations.html" %>
// if no fen was provided there is no tactic to solve
if (fen == "") {
  document.getElementById("to_win")?.classList.add("hidden");
}
</script>
<script <%= raw ListudyWeb.Plugs.CSP.put_nonce(@conn) %>>
function create_tactic() {
  let f = document.getElementById("fen_input").value;
  let m = document.getElementById("moves_input").value;
  let l = document.getElementById("last_move_input").value || "";
  let h = f + ";" + m + ";" + l
  h = btoa(h);
  window.location.hash = h;
  location.reload();
}
document.addEventListener('DOMContentLoaded', function () {
  document.getElementById('custom_tactic_form').addEventListener('submit', event => { event.preventDefault(); create_tactic(); });
  document.getElementById('fen_input').value = fen;
  document.getElementById('moves_input').value = moves;
  document.getElementById('last_move_input').value = last_move;
  let iframe_path = "<%= Routes.iframe_path(@conn, :custom_tactic, @locale) %>";
  let iframe_url = `${document.location.origin}${iframe_path}${document.location.hash}`;
  let iframe_code = `<iframe title="Chess puzzle" width="400" height="480" style="max-width:100%;border:0" src="${iframe_url}"></iframe>`;
  document.getElementById("iframe_code").value = fen ? iframe_code : "";
  document.querySelector("#custom_embed_tools .training-help").hidden = !fen;
});

</script>
<section class="training-tool-grid">
  <form id="custom_tactic_form">
    <h2 id="own"><%= dgettext("tactics", "Share a single puzzle") %></h2>
    <p><%= dgettext("tactics", "Enter a position and its solution to create a playable link.") %></p>

    <label for="fen_input"><%= dgettext "tactics", "FEN" %>:</label>
    <input type="text" id="fen_input" name="fen" required placeholder="r3k3/pppb4/6N1/3Pp3/N3n2b/8/PP1P2PP/R1B2K1R b q - 0 17">

    <label for="moves_input"><%= dgettext "tactics", "Moves" %>:</label>
    <input type="text" id="moves_input" name="moves" required placeholder="Bb5+ d3 Bxd3+ Kg1 Bf2#">

    <label for="last_move_input"><%= dgettext "tactics", "Last Move" %>:</label>
    <input type="text" id="last_move_input" name="last_move" placeholder="h8g6">

    <button type="submit" id="create_button"><%= dgettext "tactics", "Create" %></button>
  </form>
  <section id="custom_embed_tools">
    <h2><%= dgettext "tactics", "Embed this Tactic" %></h2>
    <p><%= dgettext "tactics", "Use this tactic on your website. Creates an iframe that you can use on you website to share this tactic." %></p>
    <p><%= link (dgettext "tactics", "Learn more"), to: Routes.webmaster_path(@conn, :show, @locale, "custom-tactics") %></p>
    <details class="training-help">
      <summary><%= dgettext("tactics", "Embed") %></summary>
    <label for="iframe_code"><%= dgettext("tactics", "iframe code") %></label>
    <textarea name="iframe_code" id="iframe_code" readonly spellcheck="false"></textarea>
    </details>
  </section>
</section>
</div>
