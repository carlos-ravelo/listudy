<div data-training-kind="tactics" class="training-workspace training-tool-page">
  <%= render ListudyWeb.ComponentView, "training_header.html", conn: @conn, locale: @locale, title: dgettext("webmaster", "Embed Custom Tactics") %>
  <div class="training-tool-grid">
    <section>
      <p><%= dgettext("webmaster", "Bring more interactivity to your tactics. Embed your tactics and let users solve them.") %></p>
      <h2><%= dgettext("webmaster", "How to embed your own Tactics") %></h2>
      <ol>
        <li><%= dgettext("tactics", "Enter a position and its solution to create a playable link.") %></li>
        <li><%= dgettext("webmaster", "After you have done this click on the button \"Embed\".") %></li>
        <li><%= dgettext("webmaster", "Copy the iframe code and paste it into your page.") %></li>
      </ol>
      <div class="training-actions"><%= link dgettext("webmaster", "Create your own Tactic"), to: Routes.tactic_path(@conn, :custom, @locale) <> "#own", class: "button continue_button" %></div>
      <p><%= dgettext("tactics", "For books and personal practice, use a tactics collection instead.") %> <%= link gettext("Tactics"), to: Routes.tactics_library_path(@conn, :tactics, @locale) %></p>
      <details class="training-help">
        <summary><%= dgettext("webmaster", "Implementation details") %></summary>
        <p><%= dgettext("webmaster", "The hash is the base64 encoded string which consists of the fen, the moves and the last move.") %></p>
        <code>base64.encode("${fen};${moves};${last_move}")</code>
        <p><%= dgettext("webmaster", "The values are each separated by a \";\". The moves must be in san notation and the last move in uci notation.") %></p>
        <p><%= dgettext("webmaster", "For mobile devices it is recommended to limit the width iframes to 100%. Below you will find the css to achieve that.") %></p>
        <code>iframe { max-width: 100%; border: 0; }</code>
      </details>
    </section>
    <iframe title="<%= dgettext("tactics", "Example puzzle") %>" width="400" height="480" loading="lazy" src="<%= Routes.iframe_path(@conn, :custom_tactic, @locale) %>#cjNrMy9wcHBiNC82TjEvM1BwMy9OM24yYi84L1BQMVAyUFAvUjFCMksxUiBiIHEgLSAwIDE3O0JiNSsgZDMgQnhkMysgS2cxIEJmMiM7aDhnNg=="></iframe>
  </div>
</div>
