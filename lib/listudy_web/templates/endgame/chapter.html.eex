<div class="endgame-library">
  <nav class="endgame-back" aria-label="<%= dgettext("endgame", "Endgames") %>">
    <a href="<%= Routes.endgame_path(@conn, :index, @locale) %>"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m14 5-7 7 7 7"/></svg><%= dgettext("endgame", "Endgames") %></a>
  </nav>
  <% games = practice_games(@conn, @locale, [{@slug, @chapter}]) %>
  <header class="endgame-library-heading">
    <div>
      <h1><%= @chapter.name %></h1>
      <p><%= @chapter.description %></p>
    </div>
    <%= render "_start.html", games: games, conn: @conn %>
  </header>

  <div class="endgame-exercise-groups">
    <%= for {slug, type} <- @chapter.endgames do %>
      <% group_games = practice_games(@conn, @locale, [{@slug, %{endgames: [{slug, type}]}}]) %>
      <section class="endgame-exercise-group" aria-labelledby="endgame_group_<%= slug %>">
        <header>
          <h2 id="endgame_group_<%= slug %>" class="endgame-category-title">
            <%= render "_pieces.html", conn: @conn, pieces: material_icons(@slug, slug) %>
            <span><%= type.name %></span>
          </h2>
          <%= render "_progress.html", games: group_games %>
        </header>
        <%= if Map.get(type, :description) do %>
          <p><%= type.description %></p>
        <% end %>
        <ol class="endgame-exercises">
          <%= for {game, index} <- Enum.with_index(group_games, 1) do %>
            <% label = dgettext("endgame", "Exercise %{number}", number: index) %>
            <li>
              <a id="<%= game.id %>" class="endgame-exercise" href="<%= game.url %>" data-endgame-exercise
                 data-exercise-label="<%= label %>" data-solved-label="<%= dgettext("endgame", "Solved") %>" aria-label="<%= label %>">
                <span><%= index %></span>
                <svg class="endgame-solved-mark" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>
              </a>
            </li>
          <% end %>
        </ol>
      </section>
    <% end %>
  </div>

  <details class="endgame-about">
    <summary><%= dgettext("endgame", "About this category") %></summary>
    <p><%= @chapter.body %></p>
  </details>
</div>
