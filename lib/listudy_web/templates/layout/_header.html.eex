<header class="site-header">
  <nav class="container site-navigation" aria-label="<%= gettext("Main navigation") %>">
    <a class="site-brand" href="/<%= @assigns.locale %>">listudy<span>.org</span></a>
    <button type="button" class="site-menu-toggle" aria-expanded="false" aria-controls="site-navigation-links"><%= gettext("Menu") %></button>
    <div id="site-navigation-links" class="site-navigation-links">
      <div class="site-primary-navigation">
        <%= if Pow.Plug.current_user(@conn) do %>
          <%= link gettext("Your Studies"), to: Routes.study_path(@conn, :index, @assigns.locale), data: [nav_section: "studies"] %>
        <% else %>
          <%= link gettext("Search for Studies"), to: Routes.search_path(@conn, ListudyWeb.StudySearchLive, @assigns.locale), data: [nav_section: "studies"] %>
        <% end %>
        <%= link gettext("Tactics"), to: Routes.tactics_library_path(@conn, :tactics, @assigns.locale), data: [nav_section: "tactics"] %>
        <%= if Pow.Plug.current_user(@conn) do %>
          <%= link gettext("Analysis"), to: Routes.analysis_path(@conn, :index), data: [nav_section: "analysis"] %>
        <% end %>
        <%= link gettext("Endgames"), to: Routes.endgame_path(@conn, :index, @assigns.locale), data: [nav_section: "endgames"] %>
        <%= if Pow.Plug.current_user(@conn) do %>
          <details class="site-menu">
            <summary><%= gettext("Explore") %></summary>
            <div class="site-menu-panel">
              <%= link gettext("Search for Studies"), to: Routes.search_path(@conn, ListudyWeb.StudySearchLive, @assigns.locale) %>
              <%= link gettext("Create a new Study"), to: Routes.study_path(@conn, :new, @assigns.locale) %>
            </div>
          </details>
        <% end %>
      </div>
      <div class="site-account-navigation">
        <details class="site-menu">
          <summary><%= gettext("Preferences") %></summary>
          <div class="site-menu-panel">
            <a href="#" id="toggle_dark_mode"><%= gettext("Toggle Darkmode") %></a>
            <a href="#" id="sound_settings" data-bs-toggle="modal" data-bs-target="#sound_settings_modal"><%= gettext("Sound Settings") %></a>
            <a href="#" id="board_settings" data-bs-toggle="modal" data-bs-target="#board_settings_modal"><%= gettext("Board Settings") %></a>
            <details class="site-language-menu">
              <summary><%= gettext("Language") %></summary>
              <div><%= raw ListudyWeb.Seo.lang_alternatives(@conn) %></div>
            </details>
            <%= if match?(%{role: "admin"}, Pow.Plug.current_user(@conn)) do %>
              <%= link gettext("Admin"), to: Routes.page_path(@conn, :admin_index) %>
            <% end %>
          </div>
        </details>
        <%= if user = Pow.Plug.current_user(@conn) do %>
          <details class="site-menu">
            <summary><%= user.username %></summary>
            <div class="site-menu-panel">
              <%= link gettext("Profile"), to: Routes.user_profile_path(@conn, :show, @assigns.locale, user.username) %>
              <%= link gettext("User Settings"), to: Routes.pow_registration_path(@conn, :edit) %>
              <%= link gettext("Achievements"), to: Routes.page_path(@conn, :show, @assigns.locale, "achievements") %>
              <%= link gettext("Sign out"), to: Routes.pow_session_path(@conn, :delete), method: :delete %>
            </div>
          </details>
        <% else %>
          <%= link gettext("Sign in"), to: Routes.pow_session_path(@conn, :new) %>
          <%= link gettext("Register"), to: Routes.pow_registration_path(@conn, :new) %>
        <% end %>
      </div>
    </div>
  </nav>
</header>

  <%= render ListudyWeb.ComponentView, "ui_modal.html", id: "board_settings_modal", title: gettext("Board Settings"), centered: false, body: render(ListudyWeb.ComponentView, "board_preferences.html", bootstrap_ui: true) %>
  <%= render ListudyWeb.ComponentView, "ui_modal.html", id: "sound_settings_modal", title: gettext("Sound Settings"), centered: false, body: render(ListudyWeb.ComponentView, "sound_preferences.html", bootstrap_ui: true) %>

