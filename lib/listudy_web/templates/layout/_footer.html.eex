<footer class="container site-footer site-footer-compact">
  <p class="site-footer-attribution"><%= gettext("Based on %{project} by %{author} and contributors.", project: "Listudy", author: "Arne Vogel") %></p>
  <nav aria-label="<%= gettext("Footer") %>">
    <%= link gettext("Privacy"), to: Routes.page_path(@conn, :show, @conn.assigns.locale, "privacy") %>
    <%= link gettext("Terms of Service"), to: Routes.page_path(@conn, :show, @conn.assigns.locale, "terms-of-service") %>
    <%= link gettext("Credits and license"), to: Routes.page_path(@conn, :show, @conn.assigns.locale, "credits") %>
    <a href="https://github.com/carlos-ravelo/listudy"><%= gettext("Source code") %></a>
  </nav>
</footer>
