<div class="training-workspace<%= if @tactic.source == "lichess", do: " puzzle-workspace" %>">
<%= render ListudyWeb.ComponentView, "training_header.html", conn: @socket, locale: @locale, title: if(@tactic.source == "lichess", do: gettext("Practice puzzles"), else: dgettext("tactics", "Tactic")) %>
<div class="with_sidebar">
  <%= if @tactic.source == "lichess" do %>
    <section class="puzzle-settings" aria-labelledby="puzzle-settings-title">
      <h2 id="puzzle-settings-title"><%= gettext("Practice settings") %></h2>
      <%= render ListudyWeb.ComponentView, "puzzle_filters.html", conn: @socket, locale: @locale,
            id: "practice-puzzles", filters: @filter_draft, themes: @puzzle_themes,
            count: @filter_count, live: true, error: @filter_error %>
      <div id="puzzle_autoplay_setting" class="puzzle-autoplay" phx-update="ignore">
        <label for="puzzle_autoplay">
          <span><strong><%= gettext("Next puzzle automatically") %></strong><span><%= gettext("After solving a puzzle") %></span></span>
          <input id="puzzle_autoplay" type="checkbox" role="switch">
        </label>
      </div>
    </section>
  <% end %>
  <div id="game_container" class="sidebar_main">
    <div id="tactic_board_frame" class="study-board-frame" phx-update="ignore"><%= render ListudyWeb.ComponentView, "chessground.html" %><%= render ListudyWeb.ComponentView, "promotion_picker.html" %></div>
  </div>
  <div class="sidebar">
    <%= if @tactic.source == "lichess" do %>
      <div class="puzzle-current-rating"><span><%= gettext("Puzzle rating") %></span><strong><%= @tactic.rating %></strong></div>
    <% end %>
    <div id="tactic_feedback" phx-update="ignore"><%= render ListudyWeb.ComponentView, "infoboxes.html" %></div>

    <button id="next" class="hidden continue_button" phx-click="next"><%= dgettext "tactics", "Continue"%></button>
    <details class="hidden" id="solution">
        <summary>Solution</summary>
        <%= @tactic.moves %>
    </details>

    <%= if assigns[:opening] do %>
      <p><%= dgettext("endgame", "Currently training in the opening:") <> " " <> @opening.name %></p>
    <% end %>
    <%= if assigns[:motif] do %>
      <p><%= dgettext("endgame", "Currently training in the motif:") <> " " <> @motif.name %></p>
    <% end %>
    <%= if assigns[:event] do %>
      <p><%= dgettext("endgame", "Currently playing tactics from the event:") <> " " <> @event.name %></p>
    <% end %>
    <%= if assigns[:player] do %>
      <p><%= dgettext("endgame", "Currently playing tactics by:") <> " " <> @player.name %></p>
    <% end %>

    <%= if @tactic.source == "lichess" do %>
      <details class="puzzle-about">
        <summary><%= gettext("About this puzzle") %></summary>
        <p><a href="<%= @tactic.link || "https://lichess.org/training/" <> @tactic.source_id %>" translate="no">Lichess #<%= @tactic.source_id %></a></p>
        <p><%= gettext("Puzzle data from Lichess (CC0). Progress is saved on this device.") %></p>
      </details>
    <% end %>

  </div>
</div>
</div>

<link rel="stylesheet" href="<%= Routes.static_path(@socket, "/css/chessground.css") %>"/>
<script defer type="text/javascript" src="<%= Routes.static_path(@socket, "/js/tactics.js") %>"></script>
<form class="hidden">
  <input type="hidden" id="puzzle_attempt" value="<%= @puzzle_attempt %>">
  <input type="hidden" id="puzzle_identity" value="<%= @tactic.source %>:<%= @tactic.source_id || @tactic.id %>">
  <input type="text" id="fen" value="<%= @tactic.fen %>">
  <input type="text" id="color" value="<%= @tactic.color %>">
  <input type="text" id="moves" value="<%= @tactic.moves %>">
  <input type="text" id="last_move" value="<%= @tactic.last_move %>">
</form>
<script <%= raw ListudyWeb.Plugs.CSP.put_nonce(@socket) %>>
let fen = "<%= @tactic.fen %>";
let color = "<%= @tactic.color %>";
let moves = "<%= @tactic.moves %>";
let last_move = "<%= @tactic.last_move %>";

<%= render ListudyWeb.TacticView, "translations.html" %>
</script>
